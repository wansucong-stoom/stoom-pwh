+
+/// A text insertion caret follows the glyph baseline and font em height, not
+/// the enclosing line box. Inline objects and mixed-size text can make that
+/// box much taller than this run. Hit testing still uses the original box.
+pub(super) fn text_run_caret_geometry(
+    node: &crate::renderer::render_tree::RenderNode,
+    run: &TextRunNode,
+) -> (f64, f64) {
+    // Preserve the existing orientation contract for vertical/rotated glyphs.
+    if run.is_vertical || run.rotation != 0.0 {
+        return (node.bbox.y, node.bbox.height);
+    }
+    let font_height = run.style.font_size;
+    if !font_height.is_finite() || font_height <= 0.0 || !run.baseline.is_finite() {
+        return (node.bbox.y, node.bbox.height);
+    }
+    (node.bbox.y + run.baseline - font_height * 0.8, font_height)
 }
 
