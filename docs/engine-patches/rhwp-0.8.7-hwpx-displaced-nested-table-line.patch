+
+/// A first cell line can be displaced below the table it anchors. Its saved
+/// start independently closes the measured table body plus both outer margins.
+pub(crate) fn stored_cell_line_after_nested_table(
+    para: &Paragraph,
+    measure_band: impl FnOnce(&Table) -> f64,
+    dpi: f64,
+) -> Option<&crate::model::paragraph::LineSeg> {
+    let [line] = para.line_segs.as_slice() else { return None; };
+    let table = match para.controls.as_slice() {
+        [Control::Table(table)] => table,
+        [Control::ColumnDef(columns), Control::Table(table)] if columns.column_count == 1 => table,
+        _ => return None,
+    };
+    if !para_has_non_whitespace_text(para)
+        || para.stored_text_partition_is_dirty() || para.cell_format_vpos_dirty
+        || para.source_frame_reflowed || !para.layout_space_metrics.is_empty()
+        || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        || line.line_height <= 0 || !is_para_topbottom_float(&table.common)
+        || !table.common.flow_with_text || table.common.allow_overlap
+        || table.common.vert_align != VertAlign::Top || table.caption.is_some()
+        || table.row_count < 2 || table.page_break != TablePageBreak::RowBreak
+        || signed_hwpunit(table.common.vertical_offset) > 0
+        || table.common.height == 0 || table.common.height > i32::MAX as u32
+        || table.outer_margin_top < 0 || table.outer_margin_bottom < 0
+    {
+        return None;
+    }
+    let band = i64::from(table.common.height)
+        + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom);
+    (band == i64::from(line.vertical_pos)
+        && (measure_band(table) - hwpunit_to_px(line.vertical_pos, dpi)).abs() <= hwpunit_to_px(2, dpi))
+        .then_some(line)
 }
 
