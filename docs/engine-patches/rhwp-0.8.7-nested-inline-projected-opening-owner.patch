+    fn saved_nested_inline_opening_row_band_hu(
+        table: &crate::model::table::Table,
+        row: usize,
+    ) -> Option<i64> {
+        if row == 0 || table.common.treat_as_char
+            || table.common.text_wrap != TextWrap::TopAndBottom
+            || table.common.vert_rel_to != crate::model::shape::VertRelTo::Para
+            || table.common.vertical_offset as i32 != 0
+            || table.page_break != TablePageBreak::RowBreak
+            || table.common.height > i32::MAX as u32
+            || table.cells.iter().any(|cell| cell.row_span != 1 || cell.col_span != 1)
+        {
+            return None;
+        }
+        let raw = table.get_raw_row_heights();
+        let before = raw.iter().take(row).map(|&height| i64::from(height)).sum::<i64>()
+            + i64::from(table.cell_spacing) * row as i64;
+        let band = i64::from(table.common.height) - before;
+        (band > 0 && band < i64::from(*raw.get(row)?)).then_some(band)
+    }
