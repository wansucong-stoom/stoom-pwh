+        let authentic = |paragraph: &Paragraph, line: &crate::model::paragraph::LineSeg| {
+            !paragraph.stored_text_partition_is_dirty() && !paragraph.cell_format_vpos_dirty
+                && paragraph.layout_space_metrics.is_empty() && !paragraph.source_frame_reflowed
