     /// `unit_idx`가 tagged Square/Tight/Through control의 source entry라면, 그
+    // Stored neighboring paragraph anchors can describe one horizontal picture
+    // band. Project only its outer cursor bounds into the parent row.
+    pub(super) fn stored_parallel_picture_band_units(
+        &self,
+        cell: &crate::model::table::Cell,
+        units: &[CellUnit],
+    ) -> Option<(std::ops::Range<usize>, f64, [f64; 2])> {
+        if !self.profile.get().hwpx_stored_layout() || self.profile.get().session_edited() {
+            return None;
+        }
+        let [lead, follow] = cell.paragraphs.as_slice() else { return None; };
+        let ([lead_line], [follow_line]) =
+            (lead.line_segs.as_slice(), follow.line_segs.as_slice()) else { return None; };
+        let lead_picture = match lead.controls.as_slice() {
+            [Control::Picture(pic)] => pic,
+            [Control::ColumnDef(columns), Control::Picture(pic)] if columns.column_count == 1 => pic,
+            _ => return None,
+        };
+        let [Control::Picture(follow_picture)] = follow.controls.as_slice() else { return None; };
+        if lead.text.trim().is_empty() || !follow.text.trim().is_empty()
+            || [lead, follow].iter().any(|p| !stored_float_frame_owner_is_original(p))
+            || [lead_line, follow_line].iter().any(|line|
+                line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+            || lead_line.vertical_pos != 0 || lead_line.line_height <= 0
+            || follow_line.vertical_pos != lead_line.line_height.saturating_add(lead_line.line_spacing)
+            || [lead_picture, follow_picture].iter().any(|p| {
+                let common = &p.common;
+                common.treat_as_char || common.allow_overlap || !common.flow_with_text
+                    || common.text_wrap != TextWrap::Square
+                    || common.vert_rel_to != VertRelTo::Para || common.vert_align != VertAlign::Top
+                    || common.horz_rel_to != crate::model::shape::HorzRelTo::Para
+                    || common.horz_align != crate::model::shape::HorzAlign::Left
+                    || common.width == 0 || common.width > i32::MAX as u32
+                    || common.height == 0 || common.height > i32::MAX as u32
+                    || common.margin.top < 0 || common.margin.bottom < 0
+            })
+        {
+            return None;
+        }
+        let a = &lead_picture.common;
+        let b = &follow_picture.common;
+        let ax = i64::from(signed_hwpunit(a.horizontal_offset));
+        let bx = i64::from(signed_hwpunit(b.horizontal_offset));
+        let ay = signed_hwpunit(a.vertical_offset);
+        let by = follow_line.vertical_pos.checked_add(signed_hwpunit(b.vertical_offset))?;
+        if ay < lead_line.line_height || signed_hwpunit(b.vertical_offset) != 0
+            || (i64::from(ay) - i64::from(by)).abs() > i64::from(lead_line.line_spacing.max(0))
+            || (ax + i64::from(a.width) > bx && bx + i64::from(b.width) > ax)
+        {
+            return None;
+        }
+        let start = units.iter().position(|u| u.para_idx == 0 && u.non_inline_control_range.is_some())?;
+        let end = units.iter().rposition(|u| u.para_idx == 1 && u.non_inline_control_range.is_some())? + 1;
+        if start >= end || units[start..end].iter().any(|u|
+            u.hard_break_before || u.page_frame_reset_before || u.stored_frame_break_before)
+        {
+            return None;
+        }
+        let bottom = |top, common: &CommonObjAttr| i64::from(top) + i64::from(common.height)
+            + i64::from(common.margin.top) + i64::from(common.margin.bottom);
+        let height_hu = bottom(ay, a).max(bottom(by, b)) - i64::from(ay.min(by));
+        let height = hwpunit_to_px(i32::try_from(height_hu).ok()?, self.dpi);
+        let origin = ay.min(by);
+        let offsets = [(ay, a.margin.top), (by, b.margin.top)].map(|(top, margin)| {
+            hwpunit_to_px(top - origin + i32::from(margin), self.dpi)
+        });
+        (height > 0.0 && height <= self.current_body_area.get().3 + 0.5)
+            .then_some((start..end, height, offsets))
+    }
