+    pub fn create_drawing_in_cell_by_path_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+        char_offset: usize,
+        width: u32,
+        height: u32,
+        horz_offset: u32,
+        vert_offset: u32,
+        treat_as_char: bool,
+        text_wrap_str: &str,
+        shape_type: &str,
+        line_flip_x: bool,
+        line_flip_y: bool,
+        polygon_points: &[crate::model::Point],
+    ) -> Result<String, HwpError> {
+        let source=self.resolve_paragraph_by_path(section_idx,parent_para_idx,path)?.clone();
+        if path.is_empty() || char_offset > source.char_count as usize {
+            return Err(HwpError::RenderError("도형 삽입 위치가 범위를 벗어났습니다".into()));
+        }
+        let mut shape=self.build_drawing_shape_model(section_idx,&source,char_offset,
+            width,height,horz_offset,vert_offset,treat_as_char,text_wrap_str,
+            shape_type,line_flip_x,line_flip_y,polygon_points)?;
+        Self::apply_common_obj_attr_from_json(shape.common_mut(),
+            r#"{"horzRelTo":"Column","vertRelTo":"Para"}"#);
+        let para=self.get_cell_paragraph_mut_by_path(section_idx,parent_para_idx,path)?;
+        let positions=crate::document_core::helpers::find_control_text_positions(para);
+        let index=positions.iter().position(|&p|p>char_offset).unwrap_or(para.controls.len());
+        para.align_ctrl_data_records();
+        para.controls.insert(index,Control::Shape(Box::new(shape)));
+        para.ctrl_data_records.insert(index,None);
+        para.shift_for_inline_control_insert(index,char_offset);
+        para.char_count+=8;para.control_mask|=0x00000800;para.has_para_text=true;
+        self.reflow_cell_paragraph_by_path(section_idx,parent_para_idx,path,path.last().unwrap().2);
+        self.mark_cell_control_dirty(section_idx,parent_para_idx,path[0].0);
+        self.document.sections[section_idx].raw_stream=None;
+        self.mark_section_dirty(section_idx);self.paginate_if_needed();
+        Ok(serde_json::json!({"ok":true,"paraIdx":parent_para_idx,"controlIdx":index}).to_string())
+    }
