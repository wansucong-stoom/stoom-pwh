+    /// An object-only cell may begin after its peers even within the same
+    /// row. Require the stored table box to close at the peers' visible edge.
+    fn saved_terminal_peer_leaf_frame(
+        &self, cell: &crate::model::table::Cell, host: &Paragraph, child: &crate::model::table::Table,
+    ) -> Option<(usize, usize, f64)> {
+        let profile = self.profile.get();
+        if !profile.hwpx_stored_layout() || profile.hwp5_origin_hwpx() || profile.session_edited()
+            || child.page_break != TablePageBreak::RowBreak || child.cell_spacing < 0
+            || !crate::renderer::float_placement::is_para_topbottom_float(&child.common)
+            || child.common.vertical_offset != 0 || child.common.height == 0
+            || child.outer_margin_top < 0 || child.outer_margin_bottom < 0
+            || !child.leading_header_rows().is_empty()
+            || !Self::stored_nested_outer_margin_host(host, child)
+            || !cell.paragraphs.last().is_some_and(|p| std::ptr::eq(p, host))
+            || self.render_normalization.borrow().table_text_reflowed(child)
+        { return None; }
+        let prefix = cell.paragraphs.get(..cell.paragraphs.len().checked_sub(1)?)?;
+        let origin = prefix.iter().try_fold(0, |mut expected, para| {
+            if !Self::stored_plain_cell_paragraph(para) || para.text.trim().is_empty()
+                || para.line_segs.is_empty() { return None; }
+            for line in &para.line_segs {
+                if i64::from(line.vertical_pos) != expected || line.line_height <= 0 || line.line_spacing < 0 {
+                    return None;
+                }
+                expected += i64::from(line.line_height) + i64::from(line.line_spacing);
+            }
+            Some(expected)
+        })?;
+        if origin <= 0 || origin != i64::from(host.line_segs.first()?.vertical_pos) { return None; }
+
+        let declared = i64::from(child.common.height);
+        let mut accumulated = 0;
+        for row in 0..usize::from(child.row_count) {
+            if Self::row_has_prior_rowspan_cover(child, row) { return None; }
+            let order = Self::row_cut_cell_order(child, row);
+            if order.len() != usize::from(child.col_count) { return None; }
+            let mut deferred = None;
+            let mut visible = 0;
+            for (column, index) in order.into_iter().enumerate() {
+                let cell = &child.cells[index];
+                if cell.dirty_flag || cell.row_span != 1 || cell.col_span != 1 || cell.text_direction != 0 {
+                    return None;
+                }
+                let delayed = matches!(cell.paragraphs.as_slice(), [para] if
+                    para.text.trim().is_empty() && stored_float_frame_owner_is_original(para)
+                    && matches!(para.controls.as_slice(), [Control::Table(object)] if
+                        crate::renderer::float_placement::is_para_topbottom_float(&object.common)
+                        && object.common.flow_with_text && !object.common.allow_overlap
+                        && object.common.height > 0 && object.caption.is_none()
+                        && object.common.vert_align == VertAlign::Top && object.common.vertical_offset == 0)
+                    && matches!(para.line_segs.as_slice(), [line] if line.vertical_pos == 0 && line.line_height > 0));
+                if delayed {
+                    if deferred.replace(column).is_some() { return None; }
+                    continue;
+                }
+                let frames = Self::saved_cell_source_frames(cell)?;
+                let [(_, ink)] = frames.as_slice() else { return None; };
+                let padding = i64::from(cell.effective_vertical_padding_hu(&child.padding));
+                visible = visible.max((*ink + padding).max(i64::from(cell.height)));
+            }
+            accumulated += visible + if row > 0 { i64::from(child.cell_spacing) } else { 0 };
+            if let Some(deferred) = deferred {
+                return (row > 0 && visible > 0 && accumulated == declared)
+                    .then_some((row, deferred, visible as f64 * self.dpi / 7200.0));
+            }
+            if accumulated >= declared { return None; }
+        }
+        None
+    }
+
+    pub(super) fn saved_terminal_peer_leaf_edge(
+        &self, cell: &crate::model::table::Cell, host: &Paragraph, table: &crate::model::table::Table,
+        row: usize, cut: &[usize], styles: &ResolvedStyleSet,
+    ) -> bool {
+        let Some((owner, deferred, _)) = self.saved_terminal_peer_leaf_frame(cell, host, table) else { return false; };
+        if row != owner || cut.is_empty() { return false; }
+        let mut peers = self.complete_row_cut(table, row, styles);
+        let Some(cursor) = peers.get_mut(deferred) else { return false; };
+        *cursor = 0;
+        peers == cut
+    }
+
+    fn saved_terminal_peer_leaf_ink(
+        &self, table: &crate::model::table::Table, row: usize, cut: &[usize], styles: &ResolvedStyleSet,
+    ) -> Option<f64> {
+        let order = Self::row_cut_cell_order(table, row);
+        if order.len() != cut.len() || Self::row_has_prior_rowspan_cover(table, row) { return None; }
+        let mut terminal_leaf = false;
+        let mut ink = 0.0f64;
+        for (index, &cursor) in order.into_iter().zip(cut) {
+            let cell = &table.cells[index];
+            let units = self.cell_units(cell, table, styles);
+            let (_, _, top, bottom) = self.resolve_cell_padding(cell, table);
+            let end = if cursor == units.len() {
+                Self::saved_plain_cell_end_hu(cell)?
+            } else {
+                let unit = units.get(cursor)?;
+                let fragment = unit.nested_table_fragment.as_ref()?;
+                let host = cell.paragraphs.get(unit.para_idx)?;
+                let [Control::Table(child)] = host.controls.as_slice() else { return None; };
+                if terminal_leaf || !unit.stored_frame_break_before
+                    || !self.saved_terminal_peer_leaf_edge(
+                        cell, host, child, unit.nested_row?, &fragment.start_cut, styles,
+                    )
+                { return None; }
+                terminal_leaf = true;
+                i64::from(host.line_segs.first()?.vertical_pos) + i64::from(child.common.height)
+                    + i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom)
+            };
+            ink = ink.max(top + end as f64 * self.dpi / 7200.0 + bottom);
+        }
+        terminal_leaf.then_some(ink)
     }
 
