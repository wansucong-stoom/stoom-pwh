+}
+
+/// With no stored line geometry, a single flowing table and overlay-only
+/// siblings must reserve the table's actual positive displacement before the
+/// next text paragraph. Overlay controls do not consume the flow band.
+pub(crate) fn unsegmented_empty_host_flow_offset_hu(
+    para: &Paragraph,
+    table: &Table,
+    next_para: Option<&Paragraph>,
+) -> Option<i32> {
+    if !para.line_segs.is_empty()
+        || para.text.chars().any(|c| c > '\u{001F}' && c != '\u{FFFC}' && !c.is_whitespace())
+        || table.common.treat_as_char
+        || !is_para_topbottom_float(&table.common)
+        || !matches!(table.page_break, TablePageBreak::RowBreak)
+        || signed_hwpunit(table.common.vertical_offset) <= 0
+        || !next_para.is_some_and(|next| {
+            next.line_segs.is_empty()
+                && next.text.chars().any(|c| c > '\u{001F}' && c != '\u{FFFC}' && !c.is_whitespace())
+                && next.controls.iter().all(|c| matches!(c, Control::Field(_) | Control::Bookmark(_) | Control::Hyperlink(_)))
+        })
+    { return None; }
+    let mut flowing_tables = 0;
+    for control in &para.controls {
+        let common = match control {
+            Control::Table(candidate) => {
+                if is_para_topbottom_float(&candidate.common) { flowing_tables += 1; continue; }
+                Some(&candidate.common)
+            }
+            Control::Picture(candidate) => Some(&candidate.common),
+            Control::Shape(candidate) => Some(candidate.common()),
+            Control::Equation(candidate) => Some(&candidate.common),
+            _ => None,
+        };
+        if common.is_some_and(|c| c.treat_as_char || !matches!(c.text_wrap, TextWrap::InFrontOfText | TextWrap::BehindText)) {
+            return None;
+        }
+    }
+    (flowing_tables == 1).then_some(signed_hwpunit(table.common.vertical_offset))
+}
+
+#[cfg(test)]
+mod pwh_unsegmented_offset_tests {
+    use super::*;
+    #[test]
+    fn reserves_flowing_offset_with_an_overlay_but_not_with_stored_geometry() {
+        let table = Table { page_break: TablePageBreak::RowBreak, common: CommonObjAttr {
+            treat_as_char: false, text_wrap: TextWrap::TopAndBottom,
+            vert_rel_to: VertRelTo::Para, vertical_offset: 2834, ..Default::default()
+        }, ..Default::default() };
+        let overlay = Table { common: CommonObjAttr {
+            treat_as_char: false, text_wrap: TextWrap::InFrontOfText, ..Default::default()
+        }, ..Default::default() };
+        let host = Paragraph { controls: vec![Control::Table(Box::new(table.clone())), Control::Table(Box::new(overlay))], ..Default::default() };
+        let next = Paragraph { text: "Example body".into(), ..Default::default() };
+        assert_eq!(unsegmented_empty_host_flow_offset_hu(&host, &table, Some(&next)), Some(2834));
+        let mut stored = host.clone(); stored.line_segs.push(Default::default());
+        assert_eq!(unsegmented_empty_host_flow_offset_hu(&stored, &table, Some(&next)), None);
+        let mut multiple = host.clone(); multiple.controls.push(Control::Table(Box::new(table.clone())));
+        assert_eq!(unsegmented_empty_host_flow_offset_hu(&multiple, &table, Some(&next)), None);
+        let mut inline = table.clone(); inline.common.treat_as_char = true;
+        assert_eq!(unsegmented_empty_host_flow_offset_hu(&host, &inline, Some(&next)), None);
+    }
 }
 
