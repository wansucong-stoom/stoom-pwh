+/// Inherit only the prefix before a new section's own positioned format.
+/// PageHide remains a separate rendering flag, and NewNumber visibility remains
+/// authoritative even when the previous section had an active number format.
+pub(crate) fn inherit_number_position_prefix(
+    pages: &mut [PageContent],
+    paragraphs: &[crate::model::paragraph::Paragraph],
+    previous: &Option<crate::model::control::PageNumberPos>,
+) {
+    let Some(previous) = previous else { return; };
+    let events = PageControlEvents::collect(pages, paragraphs);
+    for (page_index, page) in pages.iter_mut().enumerate() {
+        if page.page_number_pos.is_none() && events.should_inherit_number_position(page_index) {
+            page.page_number_pos = Some(previous.clone());
+        }
+    }
+}
