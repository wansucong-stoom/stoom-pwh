+/// An empty control-only paragraph can contain several independently paginated
+/// objects on one stored host line. A following format control is not owned by
+/// the first fragment of the preceding object. The source cursor after an object
+/// belongs to its final physical fragment, even when the next object opens a new
+/// page. A leading control with no predecessor uses the next object's first page.
+/// Ordinary text/line ownership retains the existing control_page contract.
+fn page_number_position_page(
+    para: &crate::model::paragraph::Paragraph,
+    control_index: usize,
+    items: &[(usize, &PageItem)],
+) -> Option<usize> {
+    if para.text.is_empty() && para.line_segs.len() == 1 {
+        let object_index = |item: &PageItem| {
+            let index = match item {
+                PageItem::Table { control_index, .. }
+                | PageItem::PartialTable { control_index, .. } => *control_index,
+                _ => return None,
+            };
+            let Some(crate::model::control::Control::Table(table)) = para.controls.get(index)
+                else { return None; };
+            (!table.common.treat_as_char && table.common.flow_with_text
+                && table.common.text_wrap == crate::model::shape::TextWrap::TopAndBottom)
+                .then_some(index)
+        };
+        // A mixed host containing any other object has no proved block-flow
+        // adjacency contract. Preserve its existing source-line interpretation.
+        if items.iter().any(|(_, item)| matches!(item,
+            PageItem::Table { .. } | PageItem::PartialTable { .. } | PageItem::Shape { .. })
+            && object_index(item).is_none())
+        { return control_page(para, control_index, items); }
+        let previous = items.iter().filter_map(|(_, item)| object_index(item))
+            .filter(|index| *index < control_index).max();
+        if let Some(previous) = previous {
+            return items.iter().filter(|(_, item)| object_index(item) == Some(previous))
+                .map(|(page, _)| *page).max();
+        }
+        let next = items.iter().filter_map(|(_, item)| object_index(item))
+            .filter(|index| *index > control_index).min();
+        if let Some(next) = next {
+            return items.iter().filter(|(_, item)| object_index(item) == Some(next))
+                .map(|(page, _)| *page).min();
+        }
+    }
+    control_page(para, control_index, items)
 }
 
