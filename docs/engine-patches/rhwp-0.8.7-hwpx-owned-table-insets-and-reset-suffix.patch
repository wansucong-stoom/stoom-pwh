+/// Confirm a run of table-only original rows followed by a separate text row.
+/// The HWPX control stream and both saved heights must identify each owner.
+pub(crate) fn stored_inline_table_prefix(para: &Paragraph) -> Option<usize> {
+    let count = para.controls.len();
+    let text_start = u32::try_from(count).ok()?.checked_mul(8)?;
+    if count < 2 || para.line_segs.get(count)?.text_start != text_start
+        || para.char_offsets.first().copied() != Some(text_start)
+        || para.text.trim().is_empty() || para.stored_text_partition_is_dirty()
+        || para.source_frame_reflowed || para.cell_format_vpos_dirty
+        || para.line_segs.iter().any(|line| line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+    {
+        return None;
+    }
+    for (index, control) in para.controls.iter().enumerate() {
+        let Control::Table(table) = control else { return None; };
+        let line = &para.line_segs[index];
+        let outer = i64::from(table.common.height) + i64::from(table.outer_margin_top)
+            + i64::from(table.outer_margin_bottom);
+        if !table.common.treat_as_char || !table.common.flow_with_text || table.common.allow_overlap
+            || table.common.text_wrap != crate::model::shape::TextWrap::TopAndBottom
+            || table.caption.is_some() || table.outer_margin_top < 0 || table.outer_margin_bottom < 0
+            || outer <= 0 || i64::from(line.line_height) != outer || line.line_height != line.text_height
+            || line.text_start != u32::try_from(index).ok()?.checked_mul(8)?
+        {
+            return None;
+        }
+    }
+    Some(count)
+}
+
+/// The final table opened this physical frame; its following original text is
+/// still part of that frame. Trailing paragraph spacing has no ink to fit.
+pub(crate) fn stored_inline_table_reset_suffix(para: &Paragraph) -> Option<(usize, &LineSeg)> {
+    let start = stored_inline_table_prefix(para)?;
+    let owner = &para.line_segs[start - 1];
+    let before = &para.line_segs[start - 2];
+    let tail = &para.line_segs[start..];
+    if before.vertical_pos <= 0 || owner.vertical_pos != 0 || owner.line_spacing < 0
+        || owner.line_height.checked_add(owner.line_spacing)? != tail[0].vertical_pos
+        || tail.iter().any(|line| line.line_height <= 0 || line.line_spacing < 0)
+        || tail.windows(2).any(|pair| {
+            pair[0].vertical_pos.checked_add(pair[0].line_height)
+                .and_then(|end| end.checked_add(pair[0].line_spacing)) != Some(pair[1].vertical_pos)
+        })
+    {
+        return None;
+    }
+    Some((start, tail.last()?))
 }
 
