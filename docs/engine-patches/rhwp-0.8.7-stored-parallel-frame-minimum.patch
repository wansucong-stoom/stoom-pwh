+/// Empty saved hosts may anchor several independent block-table frames.
+/// The trailing source line is not a text band that already owns each table's
+/// outer top margin. Frame settings and page-number markers have no geometry;
+/// other layout-owning controls keep their existing placement contracts.
+pub(crate) fn stored_coanchored_block_table_frame(para: &Paragraph, table: &Table) -> bool {
+    if !para.text.is_empty()
+        || para.stored_text_partition_is_dirty()
+        || para.cell_format_vpos_dirty
+        || !matches!(para.line_segs.as_slice(), [line]
+            if line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+                && line.vertical_pos >= 0
+                && line.line_height > 0
+                && line.segment_width >= 0)
+    {
+        return false;
+    }
+    let mut tables = 0usize;
+    let mut owns_table = false;
+    for control in &para.controls {
+        if let Control::Table(candidate) = control {
+            if candidate.common.treat_as_char
+                || !candidate.common.flow_with_text
+                || candidate.common.text_wrap != TextWrap::TopAndBottom
+                || candidate.common.vert_rel_to != VertRelTo::Para
+                || candidate.common.vert_align != VertAlign::Top
+                || signed_hwpunit(candidate.common.vertical_offset) < 0
+                || signed_hwpunit(candidate.common.width) <= 0
+                || signed_hwpunit(candidate.common.height) <= 0
+                || candidate.caption.is_some()
+                || candidate.cells.iter().any(|cell| cell.paragraphs.iter().any(|paragraph|
+                    paragraph.stored_text_partition_is_dirty() || paragraph.cell_format_vpos_dirty))
+            {
+                return false;
+            }
+            tables += 1;
+            owns_table |= std::ptr::eq(candidate.as_ref(), table);
+        } else if !crate::renderer::composer::control_is_width_neutral_marker(control) {
+            return false;
+        }
+    }
+    tables > 1 && owns_table
+}
+
+/// Independent side-by-side cells may share one saved row minimum. The object
+/// height describes each full physical frame; cell height describes the sum of
+/// its body-row boxes, excluding the repeated header. Require source resets to
+/// authenticate that interpretation before reserving any blank physical band.
+pub(crate) fn stored_coanchored_parallel_row_frame(
+    para: &Paragraph, table: &Table, row: usize, body_height: f64, dpi: f64,
+    stored: bool, edited: bool,
+) -> Option<(f64, f64)> {
+    if !stored || edited || !body_height.is_finite() || body_height <= 0.0
+        || !dpi.is_finite() || dpi <= 0.0
+        || !stored_coanchored_block_table_frame(para, table)
+        || !table.repeat_header || table.page_break != TablePageBreak::RowBreak
+        || table.cell_spacing != 0 || signed_hwpunit(table.common.vertical_offset) != 0
+    { return None; }
+    let headers = table.leading_header_rows();
+    if headers.is_empty() || row != headers.len() || row + 1 != usize::from(table.row_count)
+        || headers.iter().enumerate().any(|(index, &header)| index != header)
+    { return None; }
+    let raw = table.get_raw_row_heights();
+    let header_hu = raw.iter().take(row).map(|&height| i64::from(height)).sum::<i64>();
+    let payload_hu = i64::from(table.common.height) - header_hu;
+    let frame_hu = i64::from(table.common.height)
+        + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom);
+    let body_hu = (body_height * 7200.0 / dpi).round() as i64;
+    if payload_hu <= 0 || frame_hu > body_hu + 2 { return None; }
+    let mut cells: Vec<_> = table.cells.iter().filter(|cell|
+        usize::from(cell.row) <= row && row < usize::from(cell.row) + usize::from(cell.row_span)
+    ).collect();
+    if cells.len() < 2 { return None; }
+    cells.sort_by_key(|cell| cell.col);
+    let minimum_hu = i64::from(cells[0].height);
+    let mut column = 0usize;
+    let mut source_frames = 1usize;
+    for cell in cells {
+        if usize::from(cell.row) != row || cell.row_span != 1 || cell.col_span == 0
+            || usize::from(cell.col) != column || cell.height >= 0x8000_0000
+            || i64::from(cell.height) != minimum_hu || cell.dirty_flag
+            || cell.vertical_align != crate::model::table::VerticalAlign::Top
+            || cell.paragraphs.iter().any(|p| p.stored_text_partition_is_dirty()
+                || p.cell_format_vpos_dirty || p.line_segs.is_empty()
+                || p.line_segs.iter().any(|line|
+                    line.vertical_pos < 0 || line.line_height <= 0
+                    || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0))
+        { return None; }
+        column += usize::from(cell.col_span);
+        let lines: Vec<_> = cell.paragraphs.iter().flat_map(|p| p.line_segs.iter()).collect();
+        if lines.first()?.vertical_pos != 0 { return None; }
+        let frames = 1 + lines.windows(2).filter(|pair|
+            stored_parallel_row_page_reset(pair[0], pair[1], payload_hu)).count();
+        source_frames = source_frames.max(frames);
+    }
+    if column != usize::from(table.col_count) || source_frames <= 1
+        || minimum_hu <= payload_hu
+        || (minimum_hu + payload_hu - 1) / payload_hu != source_frames as i64
+    { return None; }
+    Some((hwpunit_to_px(table.common.height as i32, dpi),
+        hwpunit_to_px(minimum_hu as i32, dpi)))
+}
+
+/// A physical saved row restarts at its original nonnegative zero origin only
+/// after the previous line reached the frame's lower half. A paragraph-local
+/// rewind (including a short local ladder restarted at zero) is not page proof.
+pub(crate) fn stored_parallel_row_page_reset(
+    previous: &crate::model::paragraph::LineSeg,
+    current: &crate::model::paragraph::LineSeg,
+    payload_hu: i64,
+) -> bool {
+    payload_hu > 0 && previous.vertical_pos > 0 && current.vertical_pos == 0
+        && previous.line_height > 0 && current.line_height > 0
+        && (previous.tag | current.tag)
+            & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+        && i64::from(previous.vertical_pos) + i64::from(previous.line_height)
+            >= (payload_hu + 1) / 2
+}
+
+/// Space belongs to the physical row, while cuts continue to own the content.
+/// Never compress content or enlarge a fragment beyond its accepted budget.
+pub(crate) fn stored_parallel_row_fragment_height(
+    minimum: f64, used: f64, frame: f64, fixed: f64,
+    available: f64, content: f64, terminal: bool,
+) -> Option<f64> {
+    if [minimum, used, frame, fixed, available, content].iter().any(|v| !v.is_finite())
+        || minimum <= 0.0 || used < 0.0 || frame <= fixed || fixed < 0.0
+        || available < fixed || content < 0.0
+    { return None; }
+    let remaining = (minimum - used).max(0.0);
+    let capacity = (frame.min(available) - fixed).max(0.0);
+    let physical = if terminal { remaining.max(content) }
+        else { remaining.min(capacity).max(content) };
+    (physical + fixed <= available + 0.5).then_some(physical)
+}
