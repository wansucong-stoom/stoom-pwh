+
+/// A raw cell containing only its padding can still have an original
+/// multiline text box. Trust that expansion only if the complete row closes
+/// at exactly the measured height and no span crosses the source row.
+fn stored_nested_plain_tail_row_is_closed(
+    table: &crate::model::table::Table, row: usize, measured: i64,
+) -> bool {
+    let cells: Vec<_> = table.cells.iter().filter(|cell|
+        usize::from(cell.row) <= row && row < usize::from(cell.row) + usize::from(cell.row_span)
+    ).collect();
+    if cells.len() != usize::from(table.col_count) || cells.is_empty()
+        || cells.iter().any(|cell| usize::from(cell.row) != row || cell.row_span != 1
+            || cell.col_span != 1 || cell.height > i32::MAX as u32)
+    { return false; }
+    let mut columns = std::collections::BTreeSet::new();
+    let mut closed_height = 0i64;
+    let mut padding_only = false;
+    for cell in cells {
+        if cell.col >= table.col_count || !columns.insert(cell.col) { return false; }
+        let Some(end) = LayoutEngine::saved_plain_cell_end_hu(cell) else { return false; };
+        let pad = cell.effective_padding(&table.padding);
+        if pad.top < 0 || pad.bottom < 0 { return false; }
+        let padding = i64::from(pad.top) + i64::from(pad.bottom);
+        let declared = i64::from(cell.height);
+        padding_only |= declared == padding && end + padding == measured;
+        closed_height = closed_height.max(end + padding).max(declared);
+    }
+    padding_only && closed_height == measured
 }
 
