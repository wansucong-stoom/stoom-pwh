+    /// Missing TextRun caret: font metrics define its size; the cell is only
+    /// a clipping boundary. A large table frame is never a font-height source.
+    fn empty_cell_caret_geometry(
+        &self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+        char_offset: usize,
+        bounds: CellCursorBounds,
+    ) -> Result<(f64, f64, f64), HwpError> {
+        use crate::model::style::Alignment;
+        use crate::model::table::VerticalAlign;
+        let para = self.resolve_paragraph_by_path(section_idx, parent_para_idx, path)?;
+        let cell = self.resolve_cell_by_path(section_idx, parent_para_idx, path)?;
+        let table = self.resolve_table_by_path(section_idx, parent_para_idx, path)?;
+        let (left, right, top, bottom) = self.layout_engine.resolve_cell_padding(cell, table);
+        let default_char = crate::renderer::style_resolver::ResolvedCharStyle::default();
+        let style = para.char_shape_id_at(char_offset)
+            .and_then(|id| self.styles.char_styles.get(id as usize))
+            .or_else(|| self.styles.char_styles.first()).unwrap_or(&default_char);
+        let font_height = if style.font_size.is_finite() && style.font_size > 0.0 {
+            style.font_size
+        } else { default_char.font_size };
+        let default_para = crate::renderer::style_resolver::ResolvedParaStyle::default();
+        let paragraph_style = self.styles.para_styles.get(para.para_shape_id as usize)
+            .unwrap_or(&default_para);
+        let line = para.line_segs.first();
+        let line_height = line.map(|line| crate::renderer::hwpunit_to_px(
+            line.line_height, self.dpi))
+            .filter(|height| height.is_finite() && *height > 0.0).unwrap_or(font_height);
+        let baseline = line.map(|line| crate::renderer::hwpunit_to_px(
+            line.baseline_distance, self.dpi))
+            .filter(|baseline| baseline.is_finite() && *baseline >= 0.0)
+            .unwrap_or(font_height * 0.8);
+        let inner_width = (bounds.w - left - right).max(0.0);
+        let inner_height = (bounds.h - top - bottom).max(0.0);
+        let before = paragraph_style.spacing_before.max(0.0);
+        let unused = (inner_height - before - line_height).max(0.0);
+        let align_y = match cell.vertical_align {
+            VerticalAlign::Top => 0.0,
+            VerticalAlign::Center => unused * 0.5,
+            VerticalAlign::Bottom => unused,
+        };
+        let para_left = paragraph_style.margin_left + paragraph_style.indent;
+        let para_right = paragraph_style.margin_right;
+        let anchor_x = match paragraph_style.alignment {
+            Alignment::Center => (para_left + inner_width - para_right) * 0.5,
+            Alignment::Right => inner_width - para_right,
+            _ => para_left,
+        };
+        let (anchor_x, anchor_y) = if cell.text_direction == 0 {
+            (bounds.x + left + anchor_x,
+                bounds.y + top + align_y + before + (baseline - font_height * 0.8).max(0.0))
+        } else {
+            // Empty vertical cells have no glyph nodes. Match the renderer's
+            // right-to-left column origin; keep its existing caret orientation.
+            let unused_width = (inner_width - line_height).max(0.0);
+            let column_left = match cell.vertical_align {
+                VerticalAlign::Top => unused_width,
+                VerticalAlign::Center => unused_width * 0.5,
+                VerticalAlign::Bottom => 0.0,
+            };
+            let text_lead = match paragraph_style.alignment {
+                Alignment::Center => (inner_height - font_height).max(0.0) * 0.5,
+                Alignment::Right => (inner_height - font_height).max(0.0),
+                _ => 0.0,
+            };
+            (bounds.x + left + column_left + (line_height - font_height).max(0.0) * 0.5,
+                bounds.y + top + text_lead)
+        };
+        let (x, y, height, _) = clamp_cursor_to_cell_bounds(
+            anchor_x, anchor_y, font_height, bounds,
+        );
+        Ok((x, y, height))
+    }
