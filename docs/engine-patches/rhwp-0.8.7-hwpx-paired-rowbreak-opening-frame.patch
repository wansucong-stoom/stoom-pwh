+
+/// A terminal row split can use the declared opening height when the
+/// successor independently closes the remainder of that same row.
+pub(crate) fn stored_rowbreak_opening_frame_with_closing_row(
+    host: &Paragraph,
+    successor: &Paragraph,
+    table: &Table,
+    dpi: f64,
+) -> Option<f64> {
+    let [anchor] = host.line_segs.as_slice() else {
+        return None;
+    };
+    let [next] = successor.line_segs.as_slice() else {
+        return None;
+    };
+    if !host.text.is_empty()
+        || !successor.text.is_empty()
+        || !matches!(host.controls.as_slice(), [Control::Table(_)])
+        || host.source_frame_reflowed
+        || successor.source_frame_reflowed
+        || host.cell_format_vpos_dirty
+        || successor.cell_format_vpos_dirty
+        || anchor.segment_width != 0
+        || anchor.line_height <= 0
+        || next.line_height <= 0
+        || !table.common.flow_with_text
+        || table.common.allow_overlap
+        || table.common.vertical_offset != 0
+        || table.common.height > i32::MAX as u32
+    {
+        return None;
+    }
+    let closing = stored_rowbreak_closing_frame_height(host, successor, table, dpi)?;
+    let last = i32::try_from(*table.get_raw_row_heights().last()?).ok()?;
+    (closing < hwpunit_to_px(last, dpi))
+        .then(|| hwpunit_to_px(table.common.height as i32, dpi))
 }
 
