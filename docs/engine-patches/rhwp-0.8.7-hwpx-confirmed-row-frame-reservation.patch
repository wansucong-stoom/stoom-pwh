+    fn saved_contiguous_plain_frame_opening(
+        cell: &crate::model::table::Cell,
+        unit: &CellUnit,
+    ) -> Option<()> {
+        if !unit.hard_break_before || !unit.page_frame_reset_before
+            || unit.vis_start != 0 || unit.vis_end != 1
+            || unit.mixed_nested_fragment || unit.non_inline_control_range.is_some()
+            || unit.nested_row.is_some() || unit.nested_table_fragment.is_some()
+        {
+            return None;
+        }
+        let stored = |paragraph: &Paragraph, expected: i64| {
+            let [line] = paragraph.line_segs.as_slice() else { return None; };
+            let neutral_control = expected == 0
+                && matches!(paragraph.controls.as_slice(), [Control::ColumnDef(columns)]
+                    if columns.column_count == 1);
+            ((paragraph.controls.is_empty() || neutral_control) && !paragraph.text.trim().is_empty()
+                && line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+                && i64::from(line.vertical_pos) == expected
+                && line.line_height > 0 && line.line_spacing >= 0)
