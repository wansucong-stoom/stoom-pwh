+fn original_section_body_height_hu(page: &crate::model::page::PageDef) -> Option<u32> {
+    let (width, height) = if page.landscape { (page.height, page.width) } else { (page.width, page.height) };
+    if width == 0 || height == 0 || width > i32::MAX as u32 || height > i32::MAX as u32 {
+        return None;
+    }
+    // Reject malformed source geometry instead of accepting PageAreas' visual
+    // A4/default-margin fallback as evidence of an original stored frame.
+    let horizontal = page.margin_left.checked_add(page.margin_right)?.checked_add(page.margin_gutter)?;
+    let vertical = page.margin_header.checked_add(page.margin_top)?.checked_add(page.margin_footer)?.checked_add(page.margin_bottom)?;
+    if horizontal >= width || vertical >= height { return None; }
+    let areas = crate::model::page::PageAreas::from_page_def(page);
+    let height = i64::from(areas.body_area.bottom) - i64::from(areas.body_area.top);
+    (height > 0 && height <= i64::from(i32::MAX)).then_some(height as u32)
 }
 
