+    let Some(origin)=cell.paragraphs.first().and_then(|p|p.line_segs.first()) else{return false;};
+    origin.vertical_pos==0 && cell.paragraphs[..=owner].iter().all(|p|
+        !p.stored_text_partition_is_dirty() && !p.cell_format_vpos_dirty
+        && p.layout_space_metrics.is_empty() && !p.line_segs.is_empty()
