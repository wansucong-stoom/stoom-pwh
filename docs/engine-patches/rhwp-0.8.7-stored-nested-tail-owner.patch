+    fn register_source_table_body_height(&mut self, table: &Table, height: u32) {
+        let mut pending = vec![table];
+        while let Some(table) = pending.pop() {
+            self.source_body_heights_by_pointer.insert(table as *const Table as usize, height);
+            for cell in &table.cells {
