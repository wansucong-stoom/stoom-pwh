+/// Original physical opening space and the later whole-row source owner are
+/// distinct. No row is partially consumed merely to fill common.height.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct StoredNestedTailOpeningFrame {
+    tail_start_row: usize,
+    row_count: usize,
+    opening_height_hu: u32,
+    tail_height_hu: i64,
+}
+
+impl StoredNestedTailOpeningFrame {
+    pub(super) fn body_for_cut(self, start_row: usize, end_row: usize, start_cut: &[usize], end_cut: &[usize], dpi: f64) -> Option<f64> {
+        if !start_cut.is_empty() || !end_cut.is_empty() || !dpi.is_finite() || dpi<=0.0 {return None;}
+        let hu=if start_row==0 && end_row==self.tail_start_row {i64::from(self.opening_height_hu)}
+            else if start_row==self.tail_start_row && end_row==self.row_count {self.tail_height_hu}
+            else {return None;};
+        Some(hu as f64*dpi/7200.0)
+    }
