+            if let Control::Table(table) = control {
+                self.unregister_source_table_body_height(table);
+            }
+        }
+    }
+
+    fn unregister_source_table_body_height(&mut self, table: &Table) {
+        let mut pending = vec![table];
+        while let Some(table) = pending.pop() {
+            self.source_body_heights_by_pointer.remove(&(table as *const Table as usize));
+            for cell in &table.cells {
+                for paragraph in &cell.paragraphs {
+                    for control in &paragraph.controls {
+                        if let Control::Table(child) = control {pending.push(child.as_ref());}
+                    }
+                }
+            }
+        }
+    }
