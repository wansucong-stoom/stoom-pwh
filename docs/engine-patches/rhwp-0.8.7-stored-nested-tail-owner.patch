+        !p.stored_text_partition_is_dirty() && !p.cell_format_vpos_dirty
+        && p.layout_space_metrics.is_empty() && !p.line_segs.is_empty()
+        && p.line_segs.iter().all(|l| l.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY==0)
+        && p.controls.iter().all(|c| match c {Control::Table(t)=>stored_nested_tail_table_is_original(t),_=>true})))
+}
