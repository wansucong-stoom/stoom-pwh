+        for cell in &table.cells {
+            let [paragraph] = cell.paragraphs.as_slice() else { continue; };
+            let [before, after] = paragraph.line_segs.as_slice() else { continue; };
+            if before.vertical_pos != 0 || after.vertical_pos != 0 { continue; }
+            let padding = i64::from(cell.effective_vertical_padding_hu(&table.padding));
+            if restart.is_some() || !Self::stored_plain_cell_paragraph(paragraph)
+                || paragraph.text.trim().is_empty() || before.text_start >= after.text_start
+                || before.line_height <= 0 || before.line_height != after.line_height
+                || before.line_spacing < 0 || before.line_spacing != after.line_spacing
+                || before.column_start != after.column_start || before.segment_width <= 0
+                || before.segment_width != after.segment_width
+                || i64::from(cell.height) != i64::from(before.line_height) + padding
+            { return None; }
+            restart = Some((cell.row as usize, cell.col, i64::from(before.line_height)));
+        }
+        let (split_row, split_col, first_line) = restart?;
+        if split_row == 0 || split_row + 1 >= usize::from(table.row_count) { return None; }
+
+        let mut heights = Vec::with_capacity(split_row + 1);
+        for row in 0..=split_row {
+            if Self::row_has_prior_rowspan_cover(table, row) { return None; }
+            let mut col = 0;
+            let mut height = 0;
+            for index in Self::row_cut_cell_order(table, row) {
+                let cell = &table.cells[index];
+                if cell.col != col || cell.col_span == 0 || cell.row_span != 1
+                    || cell.dirty_flag || cell.text_direction != 0
+                    || !cell.paragraphs.iter().all(Self::stored_plain_cell_paragraph)
+                { return None; }
+                col = col.checked_add(cell.col_span)?;
+                let end = if row == split_row && cell.col == split_col {
