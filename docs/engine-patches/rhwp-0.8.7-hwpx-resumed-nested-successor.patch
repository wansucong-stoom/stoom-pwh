+    /// An entire child table can start a new frame after its host text has
+    /// been consumed. Its saved successor is local to that child frame.
+    pub(super) fn saved_resumed_nested_successor<'a>(
+        &self, cell: &'a crate::model::table::Cell, units: &[CellUnit],
+        start: usize, end: usize, styles: &ResolvedStyleSet,
+    ) -> Option<(usize, &'a crate::model::paragraph::LineSeg)> {
+        // An open end in a paint cut denotes the same complete tail as the
+        // bounded end used by measurement.
+        let end = if end == usize::MAX { units.len() } else { end };
+        if start == 0 || end != units.len() || start >= end.saturating_sub(1) || cell.dirty_flag
+            || cell.text_direction != 0 || !self.profile.get().hwpx_stored_layout()
+            || self.profile.get().session_edited()
+        {
+            return None;
+        }
+        let child_units = &units[start..end - 1];
+        let host_idx = child_units[0].para_idx;
+        let prior = &units[start - 1];
+        let successor_unit = &units[end - 1];
+        if prior.para_idx != host_idx || prior.vis_start != 0 || prior.vis_end != 1
+            || prior.mixed_nested_fragment
+            || units[..start].iter().rev().take_while(|u| u.para_idx == host_idx)
+                .any(|u| u.mixed_nested_fragment || u.nested_row.is_some())
+            || !child_units.iter().all(|u| u.para_idx == host_idx
+                && u.mixed_nested_fragment && !u.mixed_nested_trailing
+                && !u.mixed_nested_recursive && u.nested_table_fragment.is_none())
+            || successor_unit.para_idx != host_idx + 1
+            || successor_unit.vis_start != 0 || successor_unit.vis_end != 1
+            || successor_unit.mixed_nested_fragment
+        {
+            return None;
+        }
+        let [host, next] = cell.paragraphs.get(host_idx..)? else { return None; };
+        let [Control::Table(child)] = host.controls.as_slice() else { return None; };
+        let ([line], [successor]) = (host.line_segs.as_slice(), next.line_segs.as_slice())
+            else { return None; };
+        if host.text.trim().is_empty() || !stored_float_frame_owner_is_original(host)
+            || !Self::stored_plain_cell_paragraph(next) || next.text.trim().is_empty()
+            || line.vertical_pos < 0 || line.line_height <= 0 || successor.line_height <= 0
+            || line.segment_width <= 0 || successor.segment_width <= 0
+            || successor.vertical_pos.checked_add(successor.line_height).is_none()
+            || child.common.treat_as_char
+            || child.common.text_wrap != crate::model::shape::TextWrap::Square
+            || child.common.vert_rel_to != crate::model::shape::VertRelTo::Para
+            || child.common.vertical_offset != 0 || !child.common.flow_with_text
+            || child.common.allow_overlap || child.common.vert_align != VertAlign::Top
+            || child.caption.is_some() || child.common.height == 0
+            || child.common.height > i32::MAX as u32
+            || child.outer_margin_top < 0 || child.outer_margin_bottom < 0
+            || self.render_normalization.borrow().table_text_reflowed(child)
+            || styles.para_styles.get(next.para_shape_id as usize)?.spacing_before != 0.0
+        {
+            return None;
+        }
+        let band = i64::from(child.common.height)
+            + i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom);
+        if band != i64::from(successor.vertical_pos) { return None; }
+        let actual = self.calc_nested_table_height(child, styles);
+        ((actual * crate::renderer::HWPUNIT_PER_INCH / self.dpi).round() == band as f64)
+            .then_some((host_idx + 1, successor))
+    }
