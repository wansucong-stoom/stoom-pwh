 impl NestedMeasurements {
     pub(crate) fn clear(&self) {
         *self.0.lock().unwrap() = NestedMeasurementEntries::default();
+    }
+
+    /// Only addresses owned by the immutable document may cross from a
+    /// pagination walk to a rendering walk. Fragment-only clones stay local.
+    pub(crate) fn register_source_owners(&self, sections: &[crate::model::document::Section]) {
+        fn visit(paragraphs: &[Paragraph], entries: &mut NestedMeasurementEntries) {
+            for paragraph in paragraphs {
+                entries.source_paragraphs.insert(std::ptr::from_ref(paragraph) as usize);
+                for control in &paragraph.controls {
+                    if let Control::Table(table) = control {
+                        entries.source_tables.insert(std::ptr::from_ref(table.as_ref()) as usize);
+                        for cell in &table.cells {
+                            visit(&cell.paragraphs, entries);
+                        }
+                    }
+                }
+            }
+        }
+        let mut entries = self.0.lock().unwrap();
+        entries.source_tables.clear();
+        entries.source_paragraphs.clear();
+        for section in sections {
+            visit(&section.paragraphs, &mut entries);
+        }
+        entries.source_owners_registered = true;
+    }
+
+    pub(crate) fn has_source_owners(&self) -> bool {
+        self.0.lock().unwrap().source_owners_registered
+    }
+
+    pub(crate) fn owns_table(&self, table: &Table) -> bool {
+        self.0.lock().unwrap().source_tables.contains(&(std::ptr::from_ref(table) as usize))
+    }
+
+    pub(crate) fn owns_paragraph(&self, paragraph: &Paragraph) -> bool {
+        self.0.lock().unwrap().source_paragraphs.contains(&(std::ptr::from_ref(paragraph) as usize))
     }
 
