+            treat_as_char: false, text_wrap: TextWrap::TopAndBottom,
+            vert_rel_to: VertRelTo::Para, vert_align: VertAlign::Top,
+            vertical_offset: 1800, ..Default::default()
+        }, ..Default::default() };
+        let para = Paragraph {
+            text: "abcXYZ".into(), char_offsets: vec![0, 1, 2, 11, 12, 13],
+            line_segs: vec![LineSeg { vertical_pos: 1000, line_height: 1000, ..Default::default() }],
+            controls: vec![Control::Table(Box::new(table.clone()))], ..Default::default()
+        };
+        (para, table)
+    }
+
+    #[test]
+    fn single_line_interior_control_uses_paragraph_anchor_and_offset() {
+        let (para, table) = fixture();
+        assert_eq!(ParagraphFloatPlacement::text_interior_control_position(&para, 0), Some(3));
+        let stored = ParagraphFloatPlacement::from_stored_interior_host(&para, &table, 0, 100.0, 50.0, 96.0).unwrap();
+        assert!((stored.table_top - 124.0).abs() < 0.001);
+        let lines = [ParagraphHostLine { char_start: 0, top: 0.0, height: 1000.0 * 96.0 / 7200.0 }];
+        let computed = ParagraphFloatPlacement::from_computed_interior_host(&para, &table, 0, 100.0, &lines, 50.0, 96.0).unwrap();
+        assert!((computed.table_top - 124.0).abs() < 0.001);
+    }
