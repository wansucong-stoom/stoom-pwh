+    /// A floating table can be anchored between two runs on the same line.
+    /// Only accept an explicit scalar mapping and visible text on both sides;
+    /// line geometry is checked by the common stored/computed host path.
+    fn text_interior_control_position(para: &Paragraph, control_index: usize) -> Option<usize> {
+        let text_len = para.text.chars().count();
+        if text_len < 2 || para.char_offsets.len() != text_len || para.text.contains('\n') {
+            return None;
+        }
+        let position = *para.control_text_positions().get(control_index)?;
+        if position == 0 || position >= text_len { return None; }
+        let visible = |ch: char| !ch.is_whitespace() && !ch.is_control() && ch != '\u{fffc}';
+        (para.text.chars().take(position).any(visible)
+            && para.text.chars().skip(position).any(visible)).then_some(position)
+    }
