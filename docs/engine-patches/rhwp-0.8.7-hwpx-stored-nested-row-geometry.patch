+/// In an original noAdjust inline table the stored line boxes can grow
+/// each individual row. Use those physical rows only when they exactly close
+/// the whole object and leave room for every spanning cell.
+pub(crate) fn saved_inline_no_adjust_row_heights(
+    table: &Table,
+    dpi: f64,
+) -> Option<Vec<f64>> {
+    let row_count = usize::from(table.row_count);
+    if !table.common.treat_as_char
+        || table.raw_table_record_attr & 0x08 == 0
+        || table.common.height == 0 || table.common.height > i32::MAX as u32
+        || row_count < 2
+        || !dpi.is_finite() || dpi <= 0.0
+        || !table.cells.iter().any(|cell| cell.row_span > 1)
+    {
+        return None;
+    }
+    let mut rows = vec![0.0_f64; row_count];
+    let mut spans = Vec::new();
+    let mut grew = false;
+    for cell in &table.cells {
+        let row = usize::from(cell.row);
+        let span = usize::from(cell.row_span);
+        if span == 0 || row.checked_add(span)? > row_count
+            || cell.dirty_flag || cell.height == 0 || cell.height > i32::MAX as u32
+            || cell.paragraphs.iter().any(|para|
+                para.stored_text_partition_is_dirty() || para.cell_format_vpos_dirty
+                || para.source_frame_reflowed || !para.layout_space_metrics.is_empty())
+        {
+            return None;
+        }
+        let saved = hwpunit_to_px(cell.height as i32, dpi);
+        let [para] = cell.paragraphs.as_slice() else { return None; };
+        let [line] = para.line_segs.as_slice() else { return None; };
+        let cached_formula = matches!(para.controls.as_slice(), [Control::Field(field)]
+            if field.field_type == crate::model::control::FieldType::Formula
+                && !para.text.trim().is_empty() && para.field_ranges.len() == 1
+                && para.orphan_field_ends.is_empty());
+        if cell.text_direction != 0 || line.vertical_pos != 0 || line.line_height <= 0
+            || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+            || !(para.controls.is_empty() || cached_formula)
+        {
+            return None;
+        }
+        let end = hwpunit_to_px(line.line_height, dpi);
+        let pad = hwpunit_to_px(cell.effective_vertical_padding_hu(&table.padding), dpi);
+        let required = saved.max(end + pad);
+        if span == 1 {
+            rows[row] = rows[row].max(required);
+            grew |= required > saved;
+        } else {
+            spans.push((row, row + span, required));
+        }
+    }
+    let gap = hwpunit_to_px(i32::from(table.cell_spacing), dpi);
+    let unit = dpi / 7200.0;
+    let target = f64::from(table.common.height) * unit;
+    let total = rows.iter().sum::<f64>() + gap * (row_count - 1) as f64;
+    if !grew || rows.iter().any(|&height| height <= 0.0)
+        || (total - target).abs() > unit
+        || spans.into_iter().any(|(start, end, required)| {
+            rows[start..end].iter().sum::<f64>() + gap * ((end - start - 1) as f64)
+                < required - unit
+        })
+    {
+        return None;
+    }
+    Some(rows)
+}
