 /// 그림 띠 뒤의 빈 마지막 줄을 담는 원본 셀 프레임.
+/// A saved paragraph float can have a single row that wraps stacked
+/// paragraphs. The unwrapped rows own their individual saved heights.
+pub(crate) fn saved_stacked_float_row_heights(table: &Table, dpi: f64) -> Option<Vec<f64>> {
+    let count = usize::from(table.row_count);
+    let object = &table.common;
+    if count < 2 || object.treat_as_char || !object.flow_with_text || !object.allow_overlap
+        || object.vert_rel_to != crate::model::shape::VertRelTo::Para
+        || object.vert_align != crate::model::shape::VertAlign::Top
+        || object.text_wrap != TextWrap::TopAndBottom || signed_hwpunit(object.vertical_offset) <= 0
+        || table.caption.is_some() || table.cell_spacing < 0
+        || !dpi.is_finite() || dpi <= 0.0
+    {
+        return None;
+    }
+    let mut rows = vec![0_i64; count];
+    let mut stacked = None;
+    for cell in &table.cells {
+        let row = usize::from(cell.row);
+        if cell.row_span != 1 || cell.text_direction != 0 || cell.dirty_flag
+            || row >= count || cell.height == 0 || cell.height > i32::MAX as u32
+            || cell.paragraphs.is_empty()
+        {
+            return None;
+        }
+        let mut body = i64::from(cell.effective_vertical_padding_hu(&table.padding));
+        for (index, para) in cell.paragraphs.iter().enumerate() {
+            let [line] = para.line_segs.as_slice() else { return None; };
+            let one_column = matches!(para.controls.as_slice(), [Control::ColumnDef(columns)]
+                if columns.column_count == 1 && columns.spacing == 0);
+            if para.stored_text_partition_is_dirty() || para.cell_format_vpos_dirty
+                || para.source_frame_reflowed || !para.layout_space_metrics.is_empty()
+                || !(para.controls.is_empty() || one_column) || para.text.trim().is_empty()
+                || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                || line.vertical_pos != 0 || line.line_height <= 0 || line.line_spacing < 0
+            {
+                return None;
+            }
+            body += i64::from(line.line_height);
+            if index + 1 < cell.paragraphs.len() {
+                body += i64::from(line.line_spacing);
+            }
+        }
+        let saved = i64::from(cell.height);
+        if cell.paragraphs.len() > 1 {
+            if stacked.is_some_and(|earlier| earlier != row) {
+                return None;
+            }
+            stacked = Some(row);
+        } else if body > saved {
+            return None;
+        }
+        rows[row] = rows[row].max(saved.max(body));
+    }
+    let row = stacked?;
+    let total = rows.iter().sum::<i64>() + i64::from(table.cell_spacing) * (count - 1) as i64;
+    let leftover = i64::from(object.height) - total;
+    if leftover < 0 || rows.iter().any(|&height| height <= 0) {
+        return None;
+    }
+    rows[row] += leftover;
+    Some(rows.into_iter().map(|height| height as f64 * dpi / 7200.0).collect())
+}
