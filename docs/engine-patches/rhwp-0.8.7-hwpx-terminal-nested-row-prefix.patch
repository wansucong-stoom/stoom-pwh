+    /// A terminal floating table can declare just its opening rows. A
+    /// contiguous predecessor and the measured whole rows prove that this is
+    /// a source frame, rather than a minimum for the whole logical table.
+    pub(super) fn saved_terminal_nested_row_prefix(
+        &self, cell: &crate::model::table::Cell, host: &Paragraph,
+        child: &crate::model::table::Table,
+    ) -> Option<usize> {
+        if child.row_count < 2 || child.common.height == 0 || child.cell_spacing < 0
+            || child.outer_margin_top < 0 || child.outer_margin_bottom < 0
+            || !child.leading_header_rows().is_empty()
+            || !Self::stored_nested_outer_margin_host(host, child)
+            || !cell.paragraphs.last().is_some_and(|last| std::ptr::eq(last, host))
+        {
+            return None;
+        }
+        let [.., prior_host, before, _] = cell.paragraphs.as_slice() else { return None; };
+        let [Control::Table(previous)] = prior_host.controls.as_slice() else { return None; };
+        let [line] = before.line_segs.as_slice() else { return None; };
+        let anchor = host.line_segs.first()?;
+        if line.line_spacing < 0
+            || i64::from(line.vertical_pos) + i64::from(line.line_height) + i64::from(line.line_spacing)
+                != i64::from(anchor.vertical_pos)
+            || !self.saved_complete_nested_block(prior_host, Some(before), previous)
+        {
+            return None;
+        }
+        let declared = i64::from(child.common.height);
+        let spacing = i64::from(child.cell_spacing);
+        let rows = self.saved_complete_child_row_heights(child)?;
+        let mut end = 0;
+        for (index, &height) in rows[..rows.len().checked_sub(1)?].iter().enumerate() {
+            end += height + if index > 0 { spacing } else { 0 };
+            if end == declared { return Some(index + 1); }
+            if end > declared { return None; }
+        }
+        None
+    }
+
+    fn saved_terminal_nested_restart_ink(
+        &self, table: &crate::model::table::Table, row: usize, cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> Option<f64> {
+        let order = Self::row_cut_cell_order(table, row);
+        if cut.is_empty() || cut.len() != order.len() || Self::row_has_prior_rowspan_cover(table, row) {
+            return None;
+        }
+        let mut owner = None;
+        let mut ink = 0.0f64;
+        for (index, &cursor) in order.into_iter().zip(cut) {
+            let cell = &table.cells[index];
+            let units = self.cell_units(cell, table, styles);
+            let (_, _, top, bottom) = self.resolve_cell_padding(cell, table);
+            if cursor == units.len() {
+                let end = Self::saved_plain_cell_end_hu(cell)?;
+                ink = ink.max(top + end as f64 * self.dpi / 7200.0 + bottom);
+                continue;
+            }
+            let unit = units.get(cursor)?;
+            if owner.is_some() || !unit.stored_frame_break_before
+                || unit.nested_table_fragment.as_ref().is_some_and(|cut| cut.start_cut.iter().any(|&at| at != 0))
+            {
+                return None;
+            }
+            let host = cell.paragraphs.get(unit.para_idx)?;
+            let [Control::Table(child)] = host.controls.as_slice() else { return None; };
+            let first_tail = self.saved_terminal_nested_row_prefix(cell, host, child)?;
+            if unit.nested_row != Some(first_tail) { return None; }
+            let prior = units.get(cursor.checked_sub(1)?)?;
+            if prior.para_idx != unit.para_idx || prior.nested_row != Some(first_tail - 1)
+                || prior.nested_table_fragment.as_ref().is_some_and(|cut| !cut.terminal)
+            {
+                return None;
+            }
+            let box_bottom = i64::from(host.line_segs.first()?.vertical_pos)
+                + i64::from(child.common.height) + i64::from(child.outer_margin_top)
+                + i64::from(child.outer_margin_bottom);
+            owner = Some(top + box_bottom as f64 * self.dpi / 7200.0 + bottom);
+        }
+        owner.map(|height| ink.max(height))
     }
 
