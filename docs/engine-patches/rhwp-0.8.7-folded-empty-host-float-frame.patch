+        && !table.common.allow_overlap
+        && table.common.vertical_offset == 0
+        && matches!(table.common.vert_align, crate::model::shape::VertAlign::Top)
+        && table.caption.is_none()
+        && page.layout.column_areas.len() == 1
+        && (column_area.y - page.layout.body_area.y).abs() <= 0.5
+        && para_style.is_some_and(|style| style.spacing_before > 0.0)
+        && !para.stored_text_partition_is_dirty()
+        && !para.cell_format_vpos_dirty
+        && para.line_segs.len() == 1
+        && next_para.is_some_and(|next| {
+            !para_has_visible_text(next)
+                && !next.stored_text_partition_is_dirty()
+                && !next.cell_format_vpos_dirty
+                && next.line_segs.len() == 1
+                && next.controls.iter().any(|control| matches!(control, Control::Table(_)))
+                && {
+                    let current = &para.line_segs[0];
+                    let following = &next.line_segs[0];
+                    let advance = i64::from(following.vertical_pos) - i64::from(current.vertical_pos);
+                    let text_advance = i64::from(current.line_height) + i64::from(current.line_spacing);
+                    !is_synthetic_line_seg(current)
+                        && !is_synthetic_line_seg(following)
+                        && current.vertical_pos >= 0
+                        && current.line_height > 0
+                        && text_advance > 0
+                        && advance >= text_advance
+                        && advance < i64::from(table.common.height)
+                }
+        })
+        && ft.effective_height <= hwpunit_to_px(table.common.height as i32, dpi) + 0.5;
+    if folded_logical_host {
+        let anchor = page.current_height.max(lanes.max_bottom());
+        let top = anchor + hwpunit_to_px(i32::from(table.outer_margin_top), dpi);
+        let object_bottom = top + ft.effective_height
+            + hwpunit_to_px(i32::from(table.outer_margin_bottom), dpi);
+        // A following inline table can independently own its complete saved
+        // line. Its source origin closes the preceding float's flow frame and
