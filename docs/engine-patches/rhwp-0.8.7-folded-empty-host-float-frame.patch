+                stored_host_origin: None,
+                stored_successor_line_origin: successor_origin,
+                table_left: None,
+                table_top: top,
+                occupied_bottom: bottom,
+            };
+            return Some(EmptyFloatPlacement {
+                x_start, x_end, raw_top: anchor, reserved_height: bottom - anchor,
+                resolved: Some(resolved),
+            });
+        }
