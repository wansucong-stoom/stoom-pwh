+    /// Recover the source-local extent of a verified resumed wrapper. Its
+    /// innermost split must close at exactly the saved following line.
+    pub(super) fn saved_rowspan_wrapper_resume_rows(
+        &self, table: &crate::model::table::Table, row: usize, cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> Option<Vec<f64>> {
+        if row == 0 || row >= usize::from(table.row_count)
+            || !self.profile.get().hwpx_stored_layout() || self.profile.get().session_edited()
+            || !crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            || !table.common.flow_with_text || table.common.allow_overlap
+            || table.common.vertical_offset != 0 || table.caption.is_some()
+            || table.page_break != TablePageBreak::RowBreak
+            || self.render_normalization.borrow().table_text_reflowed(table)
+        { return None; }
+        let order = Self::row_cut_cell_order(table, row);
+        let columns = usize::from(table.col_count);
+        if order.len() != columns || cut.len() != columns { return None; }
+        let mut owner_height = None;
+        for (&index, &start) in order.iter().zip(cut) {
+            let cell = &table.cells[index];
+            if cell.col_span != 1 || cell.dirty_flag || cell.text_direction != 0 { return None; }
+            let units = self.cell_units(cell, table, styles);
+            if start == units.len() { continue; }
+            let (host, child, child_row, child_cut, following) =
+                self.saved_nested_resume_cursor(cell, &units, start, units.len())?;
+            if host != 1 || owner_height.is_some() { return None; }
+            self.saved_nested_rowspan_band_at_cut(child, child_row, child_cut, styles)?;
+            let first = self.row_cut_content_height(child, child_row, child_cut, &[], styles);
+            let rest: f64 = (child_row + 1..usize::from(child.row_count))
+                .map(|r| self.row_cut_content_height(child, r, &[], &[], styles)).sum();
+            let spacing = f64::from(child.cell_spacing)
+                * (usize::from(child.row_count) - child_row - 1) as f64;
+            let physical = (first + rest) * 7200.0 / self.dpi + spacing;
+            let margins = i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom);
+            if physical.round() as i64 + margins != i64::from(following.vertical_pos) {
+                return None;
+            }
+            owner_height = Some(i64::from(following.vertical_pos) + i64::from(following.line_height)
+                + i64::from(cell.effective_vertical_padding_hu(&table.padding)));
+        }
+        let mut heights = vec![owner_height?];
+        for row in row + 1..usize::from(table.row_count) {
+            let order = Self::row_cut_cell_order(table, row);
+            if order.len() != columns { return None; }
+            let mut height = 0;
+            for (col, index) in order.into_iter().enumerate() {
+                let cell = &table.cells[index];
+                if usize::from(cell.col) != col || cell.col_span != 1 { return None; }
+                let content = Self::saved_plain_cell_end_hu(cell)?;
+                let padding = i64::from(cell.effective_vertical_padding_hu(&table.padding));
+                height = height.max((content + padding).max(i64::from(cell.height)));
+            }
+            heights.push(height);
+        }
+        Some(heights.into_iter().map(|h| hwpunit_to_px(h as i32, self.dpi)).collect())
+    }
