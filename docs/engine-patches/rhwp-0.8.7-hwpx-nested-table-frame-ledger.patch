+    fn saved_nested_complete_cell_lines(cell: &crate::model::table::Cell) -> Option<i64> {
+        if let Some(end) = Self::saved_plain_cell_end_hu(cell) { return Some(end); }
+        let mut cursor = 0i64;
+        let mut end = 0i64;
+        for para in &cell.paragraphs {
+            if !stored_float_frame_owner_is_original(para) { return None; }
+            let [line] = para.line_segs.as_slice() else { return None; };
+            if i64::from(line.vertical_pos) != cursor || line.line_height <= 0 || line.line_spacing < 0 {
+                return None;
+            }
+            if !Self::stored_plain_cell_paragraph(para) {
+                let [Control::Table(child)] = para.controls.as_slice() else { return None; };
+                if !child.common.treat_as_char || child.caption.is_some()
