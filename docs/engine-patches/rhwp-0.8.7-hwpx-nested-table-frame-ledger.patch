+    pub(super) fn saved_complete_child_row_heights(
+        &self, table: &crate::model::table::Table,
+    ) -> Option<Vec<i64>> {
+        if !self.profile.get().hwpx_stored_layout() || self.profile.get().session_edited()
+            || !crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            || !table.common.flow_with_text || table.common.allow_overlap
+            || table.common.vertical_offset != 0 || table.caption.is_some()
+            || table.page_break != TablePageBreak::RowBreak
+            || self.render_normalization.borrow().table_text_reflowed(table)
+        { return None; }
+        let columns = usize::from(table.col_count);
+        if columns == 0 { return None; }
+        (0..usize::from(table.row_count)).map(|row| {
+            let order = Self::row_cut_cell_order(table, row);
+            if order.len() != columns { return None; }
+            let mut result = 0;
+            for (col, index) in order.into_iter().enumerate() {
+                let cell = &table.cells[index];
+                if usize::from(cell.col) != col || cell.col_span != 1 || cell.dirty_flag
+                    || cell.text_direction != 0 || cell.height > i32::MAX as u32 { return None; }
+                let padding = cell.effective_padding(&table.padding);
+                if padding.top < 0 || padding.bottom < 0 { return None; }
+                let end = Self::saved_nested_complete_cell_lines(cell)?;
+                result = result.max((end + i64::from(padding.top) + i64::from(padding.bottom))
+                    .max(i64::from(cell.height)));
+            }
+            (result > 0 && result <= i64::from(i32::MAX)).then_some(result)
+        }).collect()
+    }
