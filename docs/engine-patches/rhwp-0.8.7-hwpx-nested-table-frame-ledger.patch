+    // This is a stored first frame only if every completed row has an
+    // independent original line box and the last row closes at its first line.
+    fn saved_nested_plain_split(&self, table: &crate::model::table::Table)
+        -> Option<(Vec<f64>, i64)>
+    {
+        let profile = self.profile.get();
+        let last = usize::from(table.row_count).checked_sub(1)?;
+        if last == 0 || !profile.hwpx_stored_layout() || profile.hwp5_origin_hwpx()
+            || profile.session_edited() || table.raw_table_record_attr & 0x08 != 0
+            || !crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            || table.common.vertical_offset != 0 || !table.common.flow_with_text
+            || table.common.allow_overlap || table.caption.is_some()
+            || table.common.vert_align != VertAlign::Top || table.outer_margin_top < 0
+            || table.outer_margin_bottom < 0 || table.page_break != TablePageBreak::RowBreak
+            || table.common.height == 0 || table.common.height > i32::MAX as u32
+            || self.render_normalization.borrow().table_text_reflowed(table)
+        { return None; }
+        let columns = usize::from(table.col_count);
+        let mut heights = vec![0i64; last + 1];
+        let mut tail = None;
+        for (row, height) in heights.iter_mut().enumerate() {
+            let order = Self::row_cut_cell_order(table, row);
+            if order.len() != columns || columns == 0 { return None; }
+            for (col, index) in order.into_iter().enumerate() {
+                let cell = &table.cells[index];
+                if usize::from(cell.col) != col || cell.col_span != 1 || cell.dirty_flag
+                    || cell.text_direction != 0 || cell.height > i32::MAX as u32 { return None; }
+                let padding = cell.effective_padding(&table.padding);
+                if padding.top < 0 || padding.bottom < 0 { return None; }
+                let padding = i64::from(padding.top) + i64::from(padding.bottom);
+                let content_end = if row == last {
+                    let mut lines = cell.paragraphs.iter().flat_map(|p| p.line_segs.iter());
+                    if !cell.paragraphs.iter().all(Self::stored_plain_cell_paragraph) { return None; }
+                    let first = lines.next()?;
+                    if first.vertical_pos != 0 || first.line_height <= 0 { return None; }
+                    if let Some(second) = lines.next() {
+                        let [first_para, second_para] = cell.paragraphs.as_slice() else { return None; };
+                        if tail.is_some() || lines.next().is_some()
+                            || first_para.text.trim().is_empty() || second_para.text.trim().is_empty()
+                            || second.vertical_pos != 0 || second.line_height <= 0
+                            || first.column_start != second.column_start
+                            || first.segment_width <= 0 || first.segment_width != second.segment_width
+                            || i64::from(cell.height) != padding
+                        { return None; }
+                        tail = Some(i64::from(second.line_height) + padding);
+                    }
+                    i64::from(first.line_height)
+                } else {
+                    Self::saved_nested_complete_cell_lines(cell)?
+                };
+                *height = (*height).max((content_end + padding).max(i64::from(cell.height)));
+            }
+        }
+        let tail = tail?;
+        let frame = heights.iter().sum::<i64>() + i64::from(table.cell_spacing) * last as i64;
+        if frame != i64::from(table.common.height) { return None; }
+        Some((heights.into_iter().map(|height| hwpunit_to_px(height as i32, self.dpi)).collect(), tail))
+    }
