+                    + i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom) + padding;
+                let remainder = i64::from(cell.height) - opening;
+                if remainder < occupied { return None; }
+                remainder
+            } else {
+                occupied
+            };
+            result = Some(hwpunit_to_px(i32::try_from(height).ok()?, self.dpi));
+        }
+        result
     }
 
