+            let cell = &table.cells[index];
+            if cell.col_span != 1 || cell.dirty_flag { return None; }
+            let units = self.cell_units(cell, table, styles);
+            if start == units.len() { continue; }
+            let (next, line, reserve) =
+                self.saved_resumed_fragment_successor(cell, &units, start, units.len(), styles)?;
+            if result.is_some() { return None; }
+            let [Control::Table(child)] = cell.paragraphs[next - 1].controls.as_slice() else { return None; };
+            let padding = i64::from(cell.effective_vertical_padding_hu(&table.padding));
+            let occupied = i64::from(line.vertical_pos) + i64::from(line.line_height) + padding;
+            let height = if reserve {
+                if table.cells.iter().filter(|sibling| usize::from(sibling.row) == row)
+                    .any(|sibling| sibling.height != cell.height || sibling.row_span != 1) { return None; }
