+    pub(super) fn saved_complete_nested_block(
+        &self, host: &Paragraph, next: Option<&Paragraph>, table: &crate::model::table::Table,
+    ) -> bool {
+        if !Self::stored_nested_outer_margin_host(host, table) { return false; }
+        let Some(next) = next.filter(|p| Self::stored_plain_cell_paragraph(p) && !p.text.trim().is_empty()) else { return false; };
+        let ([anchor], [successor]) = (host.line_segs.as_slice(), next.line_segs.as_slice()) else { return false; };
+        if anchor.vertical_pos <= 0 || table.outer_margin_top < 0 || table.outer_margin_bottom < 0
+            || successor.line_height <= 0
+            || i64::from(anchor.vertical_pos) + i64::from(table.common.height)
+                + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom)
+                != i64::from(successor.vertical_pos)
+        { return false; }
+        self.saved_complete_child_row_heights(table).is_some_and(|rows| {
+            rows.iter().sum::<i64>() + i64::from(table.cell_spacing) * rows.len().saturating_sub(1) as i64
+                == i64::from(table.common.height)
+        })
+    }
