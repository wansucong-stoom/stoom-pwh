+    fn saved_nested_resume_cursor<'a, 'u>(
+        &self, cell: &'a crate::model::table::Cell, units: &'u [CellUnit],
+        start: usize, end: usize,
+    ) -> Option<(usize, &'a crate::model::table::Table, usize, &'u [usize],
+        &'a crate::model::paragraph::LineSeg)>
+    {
+        let end = end.min(units.len());
+        if start == 0 || end != units.len() || start >= end.saturating_sub(1)
+            || cell.dirty_flag || cell.text_direction != 0
+        { return None; }
+        let first = units.get(start)?;
+        let host = first.para_idx;
+        let row = first.nested_row?;
+        let start_cut = &first.nested_table_fragment.as_ref()?.start_cut;
+        let same_row = units.get(start - 1).is_some_and(|prior| prior.para_idx == host
+            && prior.nested_row == Some(row) && prior.nested_table_fragment.as_ref()
+                .is_some_and(|cut| !cut.terminal && cut.end_cut == *start_cut));
+        let successor = &units[end - 1];
+        if !same_row || units[start..end - 1].iter().any(|u| u.para_idx != host || u.nested_row.is_none())
+            || successor.para_idx != host + 1 || successor.vis_start != 0 || successor.vis_end != 1
+        { return None; }
+        let [host_para, following] = cell.paragraphs.get(host..)? else { return None; };
+        let [Control::Table(child)] = host_para.controls.as_slice() else { return None; };
+        let [line] = following.line_segs.as_slice() else { return None; };
+        if !Self::stored_nested_outer_margin_host(host_para, child)
+            || !Self::stored_plain_cell_paragraph(following) || following.text.trim().is_empty()
+            || line.vertical_pos <= 0 || line.line_height <= 0 || line.segment_width <= 0
+        { return None; }
+        Some((host, child, row, start_cut, line))
+    }
+
+    pub(super) fn saved_resumed_fragment_successor<'a>(
+        &self, cell: &'a crate::model::table::Cell, units: &[CellUnit],
+        start: usize, end: usize, styles: &ResolvedStyleSet,
+    ) -> Option<(usize, &'a crate::model::paragraph::LineSeg, bool)> {
+        let (host, child, row, cut, line) = self.saved_nested_resume_cursor(cell, units, start, end)?;
+        let margins = i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom);
+        if let Some((_, tail)) = self.saved_nested_plain_split(child) {
+            if row + 1 == usize::from(child.row_count)
+                && Self::saved_nested_plain_split_boundary(child, cut)
+                && tail + margins == i64::from(line.vertical_pos)
+            {
+                return Some((host + 1, line, false));
+            }
+        }
+        let rows = self.saved_rowspan_wrapper_resume_rows(child, row, cut, styles)?;
+        let spacing = f64::from(child.cell_spacing) * rows.len().saturating_sub(1) as f64;
+        let height = (rows.iter().sum::<f64>() * 7200.0 / self.dpi + spacing).round() as i64;
+        (height + margins == i64::from(line.vertical_pos)).then_some((host + 1, line, true))
+    }
