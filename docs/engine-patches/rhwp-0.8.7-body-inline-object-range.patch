+use crate::document_core::DocumentCore;
+use crate::document_core::helpers::{find_logical_control_positions,logical_to_text_offset,logical_paragraph_length};
+use crate::error::HwpError;
+
+impl DocumentCore {
+    /// Source-owned logical slots; structural controls never become deletable text.
+    pub fn inline_control_positions_native(&self, sec: usize, pi: usize) -> Result<String,HwpError> {
+        let para=self.document.sections.get(sec).and_then(|s|s.paragraphs.get(pi))
+            .ok_or_else(||HwpError::RenderError("Invalid body paragraph".into()))?;
+        let positions=find_logical_control_positions(para);
+        let entries=para.controls.iter().enumerate().filter(|(_,c)|c.is_logical_inline())
+            .filter_map(|(ci,_)|positions.get(ci).map(|offset|format!("{{\"controlIndex\":{},\"offset\":{}}}",ci,offset)))
+            .collect::<Vec<_>>();
+        Ok(format!("[{}]",entries.join(",")))
+    }
+
+    /// Delete a body range on the same logical axis used by hit testing and copy.
+    /// Capture/restore remains owned by the editor's existing fragment command.
+    pub fn delete_range_logical_native(&mut self,sec:usize,sp:usize,so:usize,ep:usize,eo:usize)->Result<String,HwpError>{
+        let section=self.document.sections.get(sec).ok_or_else(||HwpError::RenderError("Invalid section".into()))?;
+        if sp>ep || ep>=section.paragraphs.len() || (sp==ep&&so>eo)
+            ||so>logical_paragraph_length(&section.paragraphs[sp])||eo>logical_paragraph_length(&section.paragraphs[ep]) {
+            return Err(HwpError::RenderError("Invalid logical body range".into()));
+        }
+        let start_text=logical_to_text_offset(&section.paragraphs[sp],so).0;
+        let end_text=logical_to_text_offset(&section.paragraphs[ep],eo).0;
+        let mut removals=Vec::new();
+        for pi in sp..=ep {
+            let p=&section.paragraphs[pi];let positions=find_logical_control_positions(p);
+            let from=if pi==sp{so}else{0};let to=if pi==ep{eo}else{logical_paragraph_length(p)};
+            let indices=p.controls.iter().enumerate().filter(|(_,c)|c.is_logical_inline())
+                .filter_map(|(ci,_)|positions.get(ci).filter(|pos|**pos>=from&&**pos<to).map(|_|ci))
+                .collect::<Vec<_>>();
+            if !indices.is_empty(){removals.push((pi,indices));}
+        }
+        for (pi,indices) in removals {
+            for ci in indices.into_iter().rev(){self.document.sections[sec].paragraphs[pi].remove_control(ci);}
+            self.reflow_paragraph(sec,pi);
+            self.recompose_paragraph(sec,pi);
+        }
+        self.delete_range_native(sec,sp,start_text,ep,end_text,None)
+    }
+}
