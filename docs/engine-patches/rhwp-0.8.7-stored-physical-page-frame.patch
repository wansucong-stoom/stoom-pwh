+/// A stored page boundary is independent of the continuous coordinate ladder
+/// synthesized for missing lines. Read the original coordinates when present.
+fn source_line_vpos(para: &Paragraph, index: usize) -> Option<i32> {
+    let line = para.line_segs.get(index)?;
+    (line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0)
+        .then(|| para.source_line_seg_vertical_pos.as_ref()
+            .and_then(|positions| positions.get(index)).copied().unwrap_or(line.vertical_pos))
+}
+
+fn source_frame_is_original(para: &Paragraph) -> bool {
+    !para.stored_text_partition_is_dirty() && !para.cell_format_vpos_dirty
+        && !para.source_frame_reflowed && para.layout_space_metrics.is_empty()
+        && para.controls.iter().all(|control| match control {
+            Control::Table(table) => table.cells.iter().all(|cell| !cell.dirty_flag
+                && cell.paragraphs.iter().all(source_frame_is_original)),
+            Control::Picture(picture) => picture.caption.as_ref().is_none_or(|caption|
+                caption.paragraphs.iter().all(source_frame_is_original)),
+            _ => true,
+        })
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct StoredDeferredPictureFrame {
+    pub resume_paragraph_offset: usize,
+    pub resume_line: usize,
+    pub height_hu: i32,
+    offset_hu: i32,
+}
+
+impl StoredDeferredPictureFrame {
+    pub(crate) fn placement(self, dpi: f64) -> ParagraphFloatPlacement {
+        let bottom = hwpunit_to_px(self.height_hu, dpi);
+        ParagraphFloatPlacement {
+            flow: ParagraphFloatFlow::StoredPicture { next_flow_y: bottom },
+            anchor_y: -hwpunit_to_px(self.offset_hu, dpi),
+            stored_host_origin: None,
+            stored_successor_line_origin: None,
+            table_left: None,
+            table_top: 0.0,
+            occupied_bottom: bottom,
+        }
+    }
+}
+
+/// Prove the next-page owner from the complete picture/caption box and the
+/// original text restart. The host's visible text stays in the preceding frame.
+/// Missing-line prose may occur between the host and restart, but cannot itself
+/// supply a reset witness. A local rewind or another object ends the proof.
+pub(crate) fn stored_deferred_picture_frame(
+    host: &Paragraph,
+    following: &[Paragraph],
+    body_height_hu: i32,
+    styles: &super::style_resolver::ResolvedStyleSet,
+    dpi: f64,
+) -> Option<StoredDeferredPictureFrame> {
+    use crate::model::shape::CaptionDirection;
+    let [Control::Picture(picture)] = host.controls.as_slice() else { return None; };
+    let common = &picture.common;
+    if !source_frame_is_original(host) || !para_has_non_whitespace_text(host)
+        || common.treat_as_char || !common.flow_with_text || common.allow_overlap
+        || common.text_wrap != TextWrap::TopAndBottom || common.vert_rel_to != VertRelTo::Para
+        || common.vert_align != VertAlign::Top || body_height_hu <= 0
+        || !dpi.is_finite() || dpi <= 0.0
+        || host.line_segs.iter().any(|line| line.line_height <= 0)
+    { return None; }
+    let first = source_line_vpos(host, 0)?;
+    let mut previous = source_line_vpos(host, host.line_segs.len().checked_sub(1)?)?;
+    let offset = signed_hwpunit(common.vertical_offset);
+    let (_, picture_height) = picture_flow_frame_size_hu(picture);
+    let caption_height = if let Some(caption) = &picture.caption {
+        if caption.direction != CaptionDirection::Bottom || caption.spacing < 0
+            || caption.paragraphs.is_empty() || caption.paragraphs.iter().any(|para| {
+                para.stored_text_partition_is_dirty() || para.source_frame_reflowed
+                    || para.controls.iter().any(|control| !matches!(control,
+                        Control::AutoNumber(_) | Control::Field(_) | Control::Hyperlink(_)))
+                    || para.line_segs.is_empty()
+                    || para.line_segs.iter().any(|line| line.line_height <= 0
+                        || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+            }) { return None; }
+        let measured = super::layout::LayoutEngine::new(dpi)
+            .calculate_caption_height(&picture.caption, styles);
+        if !measured.is_finite() || measured <= 0.0 { return None; }
+        ((measured * 7200.0 / dpi).round() as i32).checked_add(i32::from(caption.spacing))?
+    } else { 0 };
+    let height = picture_height.checked_add(i32::from(common.margin.top))?
+        .checked_add(i32::from(common.margin.bottom))?.checked_add(caption_height)?;
+    if first < 0 || previous < first || previous >= body_height_hu || offset < 0
+        || height <= 0 || height > body_height_hu
+        || first.checked_add(offset)?.checked_add(height)? <= body_height_hu
+    { return None; }
+    for (paragraph_offset, para) in following.iter().enumerate() {
+        if !para.controls.is_empty() || para.stored_text_partition_is_dirty()
+            || para.cell_format_vpos_dirty || para.source_frame_reflowed
+        { return None; }
+        for (line_index, line) in para.line_segs.iter().enumerate() {
+            let Some(vpos) = source_line_vpos(para, line_index) else { continue; };
+            if line.line_height <= 0 { return None; }
+            if vpos < previous {
+                if vpos != height || !para_has_non_whitespace_text(para) { return None; }
+                return Some(StoredDeferredPictureFrame {
+                    resume_paragraph_offset: paragraph_offset + 1,
+                    resume_line: line_index, height_hu: height, offset_hu: offset,
+                });
+            }
+            if vpos >= body_height_hu { return None; }
+            previous = vpos;
+        }
+    }
+    None
+}
+
+/// An original zero restart before a complete flow-table frame is a page
+/// boundary even when the placeholder line alone still fits the preceding page.
+/// Require a source-closed object and a real body budget; arbitrary zero/local
+/// coordinates, overlapping/page-relative objects and edited frames stay out.
+pub(crate) fn stored_block_page_restart(
+    paragraphs: &[Paragraph], index: usize, body_height_hu: i32, dpi: f64,
+) -> bool {
+    let Some(current) = paragraphs.get(index) else { return false; };
+    let Some(previous) = index.checked_sub(1).and_then(|i| paragraphs.get(i)) else { return false; };
+    let Some(prev_index) = previous.line_segs.len().checked_sub(1) else { return false; };
+    let Some(prev_y) = source_line_vpos(previous, prev_index) else { return false; };
+    let Some(first) = source_line_vpos(current, 0) else { return false; };
+    let prev_line = &previous.line_segs[prev_index];
+    let prev_end = i64::from(prev_y) + i64::from(prev_line.line_height)
+        + i64::from(prev_line.line_spacing.max(0));
+    if first != 0 || prev_y <= 0 || prev_line.line_height <= 0
+        || prev_end > i64::from(body_height_hu) || !previous.controls.is_empty()
+        || !source_frame_is_original(previous) || !source_frame_is_original(current)
+    { return false; }
+    let mut host_index = index;
+    let mut prefix_end = 0;
+    while let Some(guide) = paragraphs.get(host_index) {
+        if !guide.controls.is_empty() { break; }
+        if guide.line_segs.is_empty() || guide.stored_text_partition_is_dirty() || guide.source_frame_reflowed
+        { return false; }
+        for (line_index, line) in guide.line_segs.iter().enumerate() {
+            let Some(y) = source_line_vpos(guide, line_index) else { return false; };
+            if y < prefix_end || line.line_height <= 0 { return false; }
+            prefix_end = y.saturating_add(line.line_height);
+        }
+        host_index += 1;
+    }
+    let Some(host) = paragraphs.get(host_index) else { return false; };
+    let [Control::Table(table)] = host.controls.as_slice() else { return false; };
+    let Some(next) = paragraphs.get(host_index + 1) else { return false; };
+    if table.common.treat_as_char || table.common.allow_overlap || table.caption.is_some()
+        || !source_frame_is_original(host) || !source_frame_is_original(next)
+        || source_line_vpos(host, 0).is_none_or(|y| y < prefix_end)
+    { return false; }
+    let Some(frame) = stored_empty_control_table_frame(host, next, table,
+        hwpunit_to_px(signed_hwpunit(table.common.height), dpi), 0.0, 0, dpi)
+    else { return false; };
+    let end = (frame.occupied_bottom * 7200.0 / dpi).round() as i64;
+    end > 0 && end <= i64::from(body_height_hu)
+        && prev_end + end > i64::from(body_height_hu)
+}
