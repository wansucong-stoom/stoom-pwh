+
+    /// Read document-declared substitutes that can be selected by a single
+    /// family mapping. Conflicting language slots and embedded faces stay as-is.
+    pub(crate) fn declared_print_font_substitutions(&self) -> String {
+        let mut families = std::collections::BTreeMap::new();
+        for font in self.document.doc_info.font_faces.iter().flatten() {
+            let replacement = font.subst_font.as_ref()
+                .filter(|target| !font.is_embedded && !target.is_embedded && target.font_type == 1)
+                .map(|target| target.face.trim())
+                .filter(|face| !face.is_empty() && *face != font.name);
+            families.entry(font.name.as_str())
+                .and_modify(|current| {
+                    if *current != replacement {
+                        *current = None;
+                    }
+                })
+                .or_insert(replacement);
+        }
+        let pairs: Vec<_> = families.into_iter()
+            .filter_map(|(from, to)| to.map(|to| (from, to)))
+            .collect();
+        serde_json::to_string(&pairs).expect("font name pairs are serializable")
+    }
+
+    /// Capture the current source and editing provenance for one print window.
+    /// The print window paginates this copy when it sets its font environment.
+    pub(crate) fn print_font_snapshot(&self) -> Self {
+        let mut snapshot = Self::new_empty();
+        snapshot.document = self.document.clone();
+        snapshot.font_environment = self.font_environment.clone();
+        snapshot.dpi = self.dpi;
+        snapshot.fallback_font = self.fallback_font.clone();
+        snapshot.respect_vpos_reset = self.respect_vpos_reset;
+        snapshot.hangul2024_compat = self.hangul2024_compat;
+        snapshot.clip_enabled = self.clip_enabled;
+        snapshot.restore_text_reflowed_tables_from_snapshot(
+            &self.text_reflowed_table_paths_for_snapshot(),
+        );
+        snapshot
+    }
 }
