+    /// A partial declared opening frame can place an anchored block below
+    /// its host line even when the control precedes that text in the XML.
+    /// Authenticate a complete original row prefix, not a positive offset alone.
+    /// Whole-frame and body-ineligible floats retain their existing fallback.
+    fn stored_block_begins_below_host_line(
+        &self, para: &Paragraph, child: &crate::model::table::Table,
+        row_heights: &[f64],
+    ) -> bool {
+        let profile = self.profile.get();
+        let [line] = para.line_segs.as_slice() else { return false; };
+        if !(profile.hwpx_stored_layout() || profile.hwp5_stored_pagination_layout())
+            || profile.session_edited()
+            || para.stored_text_partition_is_dirty() || para.cell_format_vpos_dirty
+            || self.render_normalization.borrow().table_text_reflowed(child)
+            || para.controls.len() != 1 || para.text.trim().is_empty()
+            || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+            || line.line_height <= 0 || line.vertical_pos < 0
+            || child.common.treat_as_char || child.caption.is_some()
+            || !matches!(child.common.text_wrap, TextWrap::TopAndBottom)
+            || !matches!(child.common.vert_rel_to, crate::model::shape::VertRelTo::Para)
+            || self.nested_table_is_overlay(child)
+            || child.common.height == 0 || child.common.height >= 0x8000_0000
+            || (child.common.vertical_offset as i32) < line.line_height
+            || child.outer_margin_top < 0 || child.outer_margin_bottom < 0
+            || row_heights.len() != usize::from(child.row_count) || row_heights.len() < 2
+            || row_heights.iter().any(|h| !h.is_finite() || *h <= 0.0)
+        { return false; }
+        let declared = hwpunit_to_px(child.common.height as i32, self.dpi);
+        let spacing = hwpunit_to_px(child.cell_spacing as i32, self.dpi);
+        let tolerance = hwpunit_to_px(2, self.dpi);
+        let full = row_heights.iter().sum::<f64>()
+            + spacing * row_heights.len().saturating_sub(1) as f64;
+        if declared + tolerance >= full || !stored_nested_tail_table_is_original(child) {
+            return false;
+        }
+        // The offset already starts at the host paragraph's origin. Check the
+        // union of its line and the opening block box; do not charge the line twice.
+        let body = self.current_body_area.get().3;
+        let occupied = hwpunit_to_px(child.common.vertical_offset as i32, self.dpi)
+            + declared + hwpunit_to_px(child.outer_margin_top as i32, self.dpi)
+            + hwpunit_to_px(child.outer_margin_bottom as i32, self.dpi);
+        if !body.is_finite() || body <= 0.0 || occupied > body + tolerance { return false; }
+        let mut prefix = 0.0;
+        for end in 1..row_heights.len() {
+            prefix += row_heights[end - 1] + if end > 1 { spacing } else { 0.0 };
+            if (prefix - declared).abs() <= tolerance {
+                return !child.cells.iter().any(|cell| usize::from(cell.row) < end
+                    && usize::from(cell.row) + usize::from(cell.row_span) > end);
+            }
+        }
+        false
+    }
