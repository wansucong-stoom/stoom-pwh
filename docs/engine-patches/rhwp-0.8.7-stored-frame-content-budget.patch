+
+/// A plain row with completed label siblings shares the original object's
+/// physical frame. Only spacing beyond that frame may be omitted at a cut;
+/// a local zero origin alone never authenticates this ownership.
+fn stored_label_row_frame_excludes_tail_spacing(
+    table: &crate::model::table::Table,
+    cell: &crate::model::table::Cell,
+    closing: &crate::model::paragraph::LineSeg,
+) -> bool {
+    if cell.dirty_flag || cell.row_span != 1 || table.common.height == 0
+        || table.common.height > i32::MAX as u32 || closing.vertical_pos < 0
+        || closing.line_height <= 0 || closing.line_spacing <= 0
+        || cell.paragraphs.iter().any(|p| !p.controls.is_empty()
+            || !stored_float_frame_owner_is_original(p))
+    { return false; }
+    let siblings = table.cells.iter().filter(|other|
+        usize::from(other.row) <= usize::from(cell.row)
+            && usize::from(cell.row) < usize::from(other.row) + usize::from(other.row_span));
+    for other in siblings {
+        if other.row != cell.row || other.row_span != 1 || other.dirty_flag {
+            return false;
+        }
+        if std::ptr::eq(other, cell) { continue; }
+        let [label] = other.paragraphs.as_slice() else { return false; };
+        let [line] = label.line_segs.as_slice() else { return false; };
+        if !label.controls.is_empty() || !stored_float_frame_owner_is_original(label)
+            || line.vertical_pos != 0 || line.line_height <= 0
+        { return false; }
+    }
+    let rows = table.get_raw_row_heights();
+    if rows.iter().take(usize::from(cell.row)).any(|&height| height == 0 || height > i32::MAX as u32) {
+        return false;
+    }
+    let prefix: i64 = rows.iter().take(usize::from(cell.row)).map(|&h| i64::from(h)).sum::<i64>()
+        + i64::from(table.cell_spacing) * i64::from(cell.row);
+    let padding = cell.effective_padding(&table.padding);
+    let ink = prefix + i64::from(closing.vertical_pos) + i64::from(closing.line_height)
+        + i64::from(padding.top) + i64::from(padding.bottom);
+    let frame = i64::from(table.common.height);
+    ink <= frame && frame < ink + i64::from(closing.line_spacing)
 }
 
