+    /// Capture one table-cell paragraph before a text/format mutation. The
+    /// outer table and unrelated cell contents are never cloned. The strict
+    /// LIFO history owner must undo later structural commands first.
+    pub fn capture_cell_text_fragment_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+    ) -> Result<u32, HwpError> {
+        let target_idx = path.last().ok_or_else(|| {
+            HwpError::RenderError("Empty cell text fragment path".to_string())
+        })?.2;
+        let text_reflowed_table_paths = self.text_reflowed_table_paths_for_snapshot();
+        // resolve_cell_by_path validates every ancestor and rejects text boxes
+        // and caption sentinels; those consumers retain their previous path.
+        let cell = self.resolve_cell_by_path(section_idx, parent_para_idx, path)?;
+        let paragraph = cell.paragraphs.get(target_idx).ok_or_else(|| {
+            HwpError::RenderError("Cell text fragment paragraph out of range".to_string())
+        })?;
+        let captured_paras = vec![paragraph.clone()];
+        let tail_line_segs = cell.paragraphs[target_idx + 1..].iter()
+            .map(|p| p.line_segs.clone()).collect();
+        let pre_para_count = cell.paragraphs.len();
+        let section = &self.document.sections[section_idx];
+        let fragment = DeleteFragment {
+            cell_text_path: Some((parent_para_idx, path.to_vec())),
+            section_idx,
+            start_para: target_idx,
+            end_para: target_idx,
+            pre_para_count,
+            captured_paras,
+            tail_line_segs,
+            raw_stream: section.raw_stream.clone(),
+            raw_provenance: section.raw_provenance.clone(),
+            caret: (self.document.doc_properties.caret_list_id,
+                    self.document.doc_properties.caret_para_id),
+            text_reflowed_table_paths,
+        };
+        let id = self.next_fragment_id;
+        self.next_fragment_id += 1;
+        self.fragment_store.push((id, fragment));
+        Ok(id)
+    }
+
+    fn restore_cell_text_fragment_native(
+        &mut self, pos: usize, frag: DeleteFragment,
+    ) -> Result<String, HwpError> {
+        let (parent_para_idx, path) = frag.cell_text_path.as_ref().expect("cell fragment");
+        // Validate before changing anything. Failed restore retains the ID so
+        // history can retry or discard it, like the body-range implementation.
+        let cell = self.resolve_cell_by_path(frag.section_idx, *parent_para_idx, path)?;
+        if cell.paragraphs.len() != frag.pre_para_count
+            || frag.start_para >= cell.paragraphs.len() {
+            return Err(HwpError::RenderError("Cell text fragment structure changed".to_string()));
+        }
+        let paragraphs = self.get_cell_paragraphs_mut_by_path(
+            frag.section_idx, *parent_para_idx, path)?;
+        paragraphs[frag.start_para] = frag.captured_paras[0].clone();
+        for (paragraph, lines) in paragraphs[frag.start_para + 1..].iter_mut()
+            .zip(&frag.tail_line_segs) {
+            paragraph.line_segs = lines.clone();
+        }
+        let section = &mut self.document.sections[frag.section_idx];
+        section.raw_stream = frag.raw_stream;
+        section.raw_provenance = frag.raw_provenance;
+        self.document.doc_properties.caret_list_id = frag.caret.0;
+        self.document.doc_properties.caret_para_id = frag.caret.1;
+        self.restore_text_reflowed_tables_from_snapshot(&frag.text_reflowed_table_paths);
+        // Source line segments and reflow provenance are already restored.
+        // Rebuilding derived caches must not run another editing reflow.
+        self.rebuild_derived_state();
+        self.fragment_store.remove(pos);
+        self.event_log.push(DocumentEvent::CellTextChanged {
+            section: frag.section_idx, para: *parent_para_idx,
+            ctrl: path[0].0, cell: path[0].1,
+        });
+        Ok(super::super::helpers::json_ok_with(&format!(
+            "\"paraIdx\":{},\"charOffset\":0", frag.start_para)))
+    }
