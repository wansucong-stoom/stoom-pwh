+    /// The typed unit stream owns block/text order in a mixed paragraph.
+    /// None keeps legacy float/overlay/multi-control paragraphs unchanged.
+    pub(super) fn cell_paragraph_projected_block_order(
+        &self,
+        cell: &crate::model::table::Cell,
+        table: &crate::model::table::Table,
+        styles: &ResolvedStyleSet,
+        para_idx: usize,
+    ) -> Option<bool> {
+        let para = cell.paragraphs.get(para_idx)?;
+        if para.text.trim().is_empty() {
+            return None;
+        }
+        let units = self.cell_units(cell, table, styles);
+        let first_table = units.iter().position(|unit|
+            unit.para_idx == para_idx && unit.nested_row.is_some())?;
+        let first_text = units.iter().position(|unit|
+            unit.para_idx == para_idx && unit.nested_row.is_none()
+                && unit.vis_start < unit.vis_end)?;
+        Some(first_table < first_text)
+    }
+
     /// Use the exact nested atoms where one table has an unambiguous owner.
     /// Multi-control mixed paragraphs keep the legacy path until their atoms
     /// carry control indexes; paragraph identity alone cannot distinguish them.
