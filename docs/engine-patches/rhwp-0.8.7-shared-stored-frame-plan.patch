+/// An empty flow-picture host at the physical tail cannot pull its picture
+/// upward to fit. A following explicit page break closes this frame without a
+/// text restart below the picture: emit its own fresh page before that break.
+fn stored_standalone_picture_page(
+    previous: &Paragraph, host: &Paragraph, next: &Paragraph,
+    body_height_hu: i32, dpi: f64,
+) -> Option<StoredDeferredPictureFrame> {
+    use crate::model::paragraph::ColumnBreakType;
+    let [Control::Picture(picture)] = host.controls.as_slice() else { return None; };
+    let [line] = host.line_segs.as_slice() else { return None; };
+    let common = &picture.common;
+    if !source_frame_is_original(previous) || !original_para_top_flow_block(host, common)
+        || !source_frame_is_original(next) || !previous.controls.is_empty()
+        || para_has_non_whitespace_text(host) || host.column_type != ColumnBreakType::None
+        || !matches!(next.column_type, ColumnBreakType::Page | ColumnBreakType::Section)
+        || !next.controls.is_empty() || source_line_vpos(next, 0) != Some(0)
+        || picture.caption.is_some()
+        || line.line_height <= 0 || body_height_hu <= 0 || !dpi.is_finite() || dpi <= 0.0
+    { return None; }
+    let previous_index = previous.line_segs.len().checked_sub(1)?;
+    let previous_line = previous.line_segs.get(previous_index)?;
+    let previous_end = source_line_vpos(previous, previous_index)?
+        .checked_add(previous_line.line_height)?.checked_add(previous_line.line_spacing.max(0))?;
+    let origin = source_line_vpos(host, 0)?;
+    let offset = signed_hwpunit(common.vertical_offset);
+    let (_, height) = picture_flow_frame_size_hu(picture);
+    let total = height.checked_add(i32::from(common.margin.top))?
+        .checked_add(i32::from(common.margin.bottom))?;
+    if previous_end != origin || origin <= 0 || origin >= body_height_hu || offset < 0
+        || total <= 0 || total > body_height_hu
+        || origin.checked_add(offset)?.checked_add(total)? <= body_height_hu
+    { return None; }
+    Some(StoredDeferredPictureFrame {
+        resume_paragraph_offset: 0, resume_line: 0, height_hu: total, offset_hu: offset,
+    })
+}
