+/// A source page-start paragraph may place its visible text below a leading
+/// table. Its positive first origin owns the entire table reservation already.
+/// Require the outer box and the successor text to close that original frame;
+/// edited, local, overlapping and unclosed coordinates are not evidence.
+pub(crate) fn stored_leading_table_host_frame(
+    host: &Paragraph, next: &Paragraph, body_height_hu: i32,
+) -> bool {
+    use crate::model::paragraph::ColumnBreakType;
+    let [Control::Table(table)] = host.controls.as_slice() else { return false; };
+    let common = &table.common;
+    if !matches!(host.column_type, ColumnBreakType::Page | ColumnBreakType::Section)
+        || !original_para_top_flow_block(host, common) || !source_frame_is_original(next)
+        || !source_table_box_contains_text(table)
+        || !para_has_non_whitespace_text(host) || !next.controls.is_empty()
+        || table.caption.is_some()
+        || common.height == 0 || common.height > i32::MAX as u32
+        || body_height_hu <= 0 || host.line_segs.is_empty()
+    { return false; }
+    let offset = signed_hwpunit(common.vertical_offset);
+    let bottom = i64::from(offset) + i64::from(common.height)
+        + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom);
+    if offset < 0 || bottom <= 0 || bottom > i64::from(body_height_hu)
+        || source_line_vpos(host, 0).map(i64::from) != Some(bottom)
+    { return false; }
+    let mut end = bottom;
+    for (index, line) in host.line_segs.iter().enumerate() {
+        if line.line_height <= 0 || source_line_vpos(host, index).map(i64::from) != Some(end) {
+            return false;
+        }
+        end += i64::from(line.line_height) + i64::from(line.line_spacing.max(0));
+    }
+    end <= i64::from(body_height_hu)
+        && source_line_vpos(next, 0).map(i64::from) == Some(end)
+}
