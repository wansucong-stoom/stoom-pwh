+/// Normalized ownership of an original paragraph frame. Import repairs text
+/// metrics; this plan alone assigns the object reservation and page owner.
+#[derive(Clone, Copy)]
+pub(crate) enum StoredFrameReservation {
+    HostFlow,
+    IncludedInHostOrigin,
+    RemotePicture { frame: StoredDeferredPictureFrame, standalone: bool },
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct StoredPageFramePlan {
+    pub restart_before_host: bool,
+    pub reservation: StoredFrameReservation,
+}
+
+impl StoredPageFramePlan {
+    pub(crate) fn picture_frame(self) -> Option<(StoredDeferredPictureFrame, bool)> {
+        match self.reservation {
+            StoredFrameReservation::RemotePicture { frame, standalone } => Some((frame, standalone)),
+            _ => None,
+        }
+    }
+}
+
+pub(crate) fn stored_page_frame_plan(
+    paragraphs: &[Paragraph], index: usize, body_height_hu: i32,
+    styles: &super::style_resolver::ResolvedStyleSet, dpi: f64,
+) -> StoredPageFramePlan {
+    let mut plan = StoredPageFramePlan {
+        restart_before_host: stored_block_page_restart(paragraphs, index, body_height_hu, dpi),
+        reservation: StoredFrameReservation::HostFlow,
+    };
+    let Some(host) = paragraphs.get(index) else { return plan; };
+    let Some(next) = paragraphs.get(index + 1) else { return plan; };
+    if stored_leading_table_host_frame(host, next, body_height_hu) {
+        plan.reservation = StoredFrameReservation::IncludedInHostOrigin;
+    } else if let Some(frame) = stored_deferred_picture_frame(
+        host, &paragraphs[index + 1..], body_height_hu, styles, dpi) {
+        plan.reservation = StoredFrameReservation::RemotePicture { frame, standalone: false };
+    } else if let Some(frame) = index.checked_sub(1).and_then(|i| paragraphs.get(i))
+        .and_then(|previous| stored_standalone_picture_page(previous, host, next, body_height_hu, dpi)) {
+        plan.reservation = StoredFrameReservation::RemotePicture { frame, standalone: true };
+    }
+    plan
+}
