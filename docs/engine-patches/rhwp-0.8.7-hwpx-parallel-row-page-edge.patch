+    /// A saved HWPX table can split its last row independently in each cell.
+    /// Authenticate the first physical frame against the repeated header, the
+    /// declared table edge and the first restart in every parallel cell.
+    fn hwpx_parallel_first_frame_closes(
+        table: &crate::model::table::Table,
+        cell: &crate::model::table::Cell,
+        previous: &crate::model::paragraph::LineSeg,
+        next: &crate::model::paragraph::LineSeg,
+    ) -> bool {
+        let row = usize::from(cell.row);
+        if row == 0
+            || row + 1 != usize::from(table.row_count)
+            || !table.repeat_header
+            || table.common.text_wrap != TextWrap::TopAndBottom
+            || !table.common.flow_with_text
+            || table.leading_header_rows().len() != row
+        {
+            return false;
+        }
+
+        let header_height = table
+            .get_raw_row_heights()
+            .iter()
+            .take(row)
+            .map(|&height| i64::from(height))
+            .sum::<i64>()
+            + i64::from(table.cell_spacing) * row as i64;
+        let frame = i64::from(table.common.height) - header_height;
+        let padding = cell.effective_padding(&table.padding);
+        let visible_end = i64::from(previous.vertical_pos)
+            + i64::from(previous.line_height)
+            + i64::from(padding.top)
+            + i64::from(padding.bottom);
+        let spacing = i64::from(previous.line_spacing);
+        if visible_end > frame || visible_end + spacing <= frame {
+            return false;
+        }
+
+        let mut parallel_count = 0;
+        for owner in table.cells.iter().filter(|owner| {
+            let start = usize::from(owner.row);
+            start <= row && row < start + usize::from(owner.row_span)
+        }) {
+            if owner.row != cell.row
+                || owner.row_span != 1
+                || owner.vertical_align != VerticalAlign::Top
+                || owner.dirty_flag
+                || i64::from(owner.height) <= frame
+            {
+                return false;
+            }
+            let mut prior: Option<&crate::model::paragraph::LineSeg> = None;
+            let mut restart = None;
+            'prefix: for para in &owner.paragraphs {
+                if !para.controls.is_empty()
+                    || para.stored_text_partition_is_dirty()
+                    || para.cell_format_vpos_dirty
+                    || para.line_segs.is_empty()
+                {
+                    return false;
+                }
+                for seg in &para.line_segs {
+                    if seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                        || seg.line_height <= 0
+                        || seg.vertical_pos < 0
+                    {
+                        return false;
+                    }
+                    if let Some(last) = prior {
+                        if seg.vertical_pos < last.vertical_pos {
+                            restart = Some((last, seg));
+                            break 'prefix;
+                        }
+                    }
+                    prior = Some(seg);
+                }
+            }
+            let Some((last, first)) = restart else {
+                return false;
+            };
+            if !crate::renderer::float_placement::stored_parallel_row_page_reset(last, first, frame) {
+                return false;
+            }
+            if std::ptr::eq(owner, cell) {
+                if !std::ptr::eq(last, previous) || !std::ptr::eq(first, next) {
+                    return false;
+                }
+            } else {
+                let owner_padding = owner.effective_padding(&table.padding);
+                let owner_end = i64::from(last.vertical_pos)
+                    + i64::from(last.line_height)
+                    + i64::from(owner_padding.top)
+                    + i64::from(owner_padding.bottom);
+                let line_advance = i64::from(last.line_height) + i64::from(last.line_spacing.max(0));
+                if owner_end > frame || (visible_end - owner_end).abs() > line_advance {
+                    return false;
+                }
+                parallel_count += 1;
+            }
+        }
+        parallel_count > 0
+    }
