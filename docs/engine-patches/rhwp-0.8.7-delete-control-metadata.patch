+            if *position >= slot_end { *position -= CTRL_CHAR_CODE_UNITS; }
+            else if *position > slot_start { *position = slot_start; }
+        };
+        for offset in &mut self.char_offsets {
+            if *offset >= slot_end { *offset -= CTRL_CHAR_CODE_UNITS; }
+        }
