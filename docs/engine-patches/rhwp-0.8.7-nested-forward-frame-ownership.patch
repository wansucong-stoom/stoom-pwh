+//! HWPX 저장 후에도 재조판된 셀 문단을 원본 저장 프레임의 증거로 재사용하지 않는다.
+//! 표준 XML 속성은 바꾸지 않는다. 보조 정보는 동일 header/section 바이트 및 구조
+//! 경로에서만 유효하며, 외부 재저장·버전 불일치·손상은 이력 없음으로 처리한다.
+use super::{control::Control, document::Document, paragraph::Paragraph};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+
+pub(crate) const HWPX_ENTRY: &str = "META-INF/rhwp-source-layout-history.json";
+pub(crate) const MAX_BYTES: usize = 4 * 1024 * 1024;
+const MAX_RECORDS: usize = 16_384;
+const MAX_DEPTH: usize = 32;
+
+pub(crate) fn digest(bytes: &[u8]) -> [u8; 32] {
+    Sha256::digest(bytes).into()
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    // Body paragraph, then (table ordinal, cell row/col/span, cell paragraph).
+    // Cell vector order and metadata-control offsets are not stable in HWPX.
+    path: Vec<usize>,
+    fingerprint: [u8; 32],
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SectionHistory {
+    index: usize,
+    fingerprint: [u8; 32],
+    records: Vec<Record>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    version: u8,
+    header: [u8; 32],
+    sections: Vec<SectionHistory>,
+}
+
+fn paragraph_fingerprint(p: &Paragraph) -> [u8; 32] {
+    let mut h = Sha256::new();
+    h.update((p.text.len() as u64).to_le_bytes());
+    h.update(p.text.as_bytes());
+    h.update((p.line_segs.len() as u64).to_le_bytes());
+    for line in &p.line_segs {
+        // These values are unchanged by the HWPX/HWP5 control-axis adapter.
+        for value in [line.line_height, line.text_height, line.baseline_distance, line.line_spacing] {
+            h.update(value.to_le_bytes());
+        }
+    }
+    h.finalize().into()
+}
+
+fn collect(p: &Paragraph, path: &mut Vec<usize>, records: &mut Vec<Record>) {
+    if records.len() >= MAX_RECORDS || path.len() > 1 + MAX_DEPTH * 6 { return; }
+    if path.len() > 1 && (p.source_frame_reflowed || !p.layout_space_metrics.is_empty()) {
+        records.push(Record { path: path.clone(), fingerprint: paragraph_fingerprint(p) });
+    }
+    if path.len() == 1 + MAX_DEPTH * 6 { return; }
+    for (ordinal, table) in p.controls.iter().filter_map(|c| match c {
+        Control::Table(table) => Some(table), _ => None,
+    }).enumerate() {
+        let mut addresses = HashSet::new();
+        if table.cells.iter().any(|cell| !addresses.insert((cell.row, cell.col))) { continue; }
+        for cell in &table.cells {
+            for (paragraph_index, paragraph) in cell.paragraphs.iter().enumerate() {
+                path.extend([ordinal, usize::from(cell.row), usize::from(cell.col),
+                    usize::from(cell.row_span), usize::from(cell.col_span), paragraph_index]);
+                collect(paragraph, path, records);
+                path.truncate(path.len() - 6);
+            }
+        }
+    }
+}
+
+pub(crate) fn encode(doc: &Document, header: &[u8], hashes: &[[u8; 32]]) -> Option<Vec<u8>> {
+    if hashes.len() != doc.sections.len() || hashes.len() > MAX_RECORDS { return None; }
+    let mut sections = Vec::new();
+    let mut total = 0usize;
+    for (index, section) in doc.sections.iter().enumerate() {
+        let mut records = Vec::new();
+        for (paragraph_index, paragraph) in section.paragraphs.iter().enumerate() {
+            collect(paragraph, &mut vec![paragraph_index], &mut records);
+        }
+        total = total.checked_add(records.len())?;
+        if total >= MAX_RECORDS { return None; }
+        if !records.is_empty() {
+            sections.push(SectionHistory { index, fingerprint: hashes[index], records });
+        }
+    }
+    if sections.is_empty() { return None; }
+    let bytes = serde_json::to_vec(&Envelope { version: 1, header: digest(header), sections }).ok()?;
+    (bytes.len() <= MAX_BYTES).then_some(bytes)
+}
+
+fn paragraph_at<'a>(p: &'a mut Paragraph, path: &[usize]) -> Option<&'a mut Paragraph> {
+    if path.is_empty() { return Some(p); }
+    if path.len() < 6 { return None; }
+    let table = p.controls.iter_mut().filter_map(|c| match c {
+        Control::Table(table) => Some(table), _ => None,
+    }).nth(path[0])?;
+    let indices: Vec<_> = table.cells.iter().enumerate().filter_map(|(i, cell)|
+        (usize::from(cell.row) == path[1] && usize::from(cell.col) == path[2]).then_some(i)
+    ).collect();
+    let [index] = indices.as_slice() else { return None; };
+    let cell = &mut table.cells[*index];
+    if usize::from(cell.row_span) != path[3] || usize::from(cell.col_span) != path[4] { return None; }
+    paragraph_at(cell.paragraphs.get_mut(path[5])?, &path[6..])
+}
+
+pub(crate) fn decode(doc: &mut Document, bytes: &[u8], header: &[u8], hashes: &[[u8; 32]]) {
+    if bytes.len() > MAX_BYTES || hashes.len() != doc.sections.len() { return; }
+    let Ok(envelope) = serde_json::from_slice::<Envelope>(bytes) else { return; };
+    if envelope.version != 1 || envelope.header != digest(header)
+        || envelope.sections.len() > hashes.len() { return; }
+    let mut sections = HashSet::new();
+    let mut total = 0usize;
+    for section in &envelope.sections {
+        if !sections.insert(section.index) || section.index >= hashes.len() { return; }
+        total = match total.checked_add(section.records.len()) { Some(n) => n, None => return };
+        if total >= MAX_RECORDS { return; }
+        let mut paths = HashSet::new();
+        if section.records.iter().any(|record| record.path.len() < 7
+            || record.path.len() > 1 + MAX_DEPTH * 6 || (record.path.len() - 1) % 6 != 0
+            || !paths.insert(&record.path)) { return; }
+    }
+    for section in envelope.sections {
+        if section.fingerprint != hashes[section.index] { continue; }
+        for record in section.records {
+            let Some(p) = doc.sections[section.index].paragraphs.get_mut(record.path[0]) else { continue; };
+            let Some(p) = paragraph_at(p, &record.path[1..]) else { continue; };
+            if paragraph_fingerprint(p) == record.fingerprint {
+                p.source_frame_reflowed = true;
+            }
+        }
+    }
+}
