+/// An expanded source row is admissible only when its one-line inline owner
+/// independently closes the measured box. This is not permission to trust a
+/// different measured height for an ordinary text row or a merged row.
+fn stored_nested_inline_tail_row_is_closed(
+    table: &crate::model::table::Table, row: usize, measured: i64,
+) -> bool {
+    let cells: Vec<_> = table.cells.iter().filter(|cell|
+        usize::from(cell.row) <= row && row < usize::from(cell.row) + usize::from(cell.row_span)
+    ).collect();
+    if cells.len() != usize::from(table.col_count) || cells.is_empty()
+        || cells.iter().any(|cell| usize::from(cell.row) != row || cell.row_span != 1
+            || cell.col_span != 1 || cell.text_direction != 0 || cell.paragraphs.len() != 1)
+    { return false; }
+    let mut columns = std::collections::BTreeSet::new();
+    let mut closed_height = 0i64;
+    let mut inline_height = 0i64;
+    for cell in cells {
+        if cell.col >= table.col_count || !columns.insert(cell.col) { return false; }
+        let para = &cell.paragraphs[0];
+        let [line] = para.line_segs.as_slice() else { return false; };
+        // HWPX colPr(colCount=1) is restored as the 0x02 column-declaration
+        // bit and MultiColumn enum even though it has no layout break. The
+        // exact single-column metadata owner is checked again below.
+        let one_column_metadata = para.column_type == crate::model::paragraph::ColumnBreakType::MultiColumn
+            && para.raw_break_type == 0x02
+            && para.controls.iter().any(|control| matches!(control,
+                Control::ColumnDef(columns) if columns.column_count == 1));
+        if (para.column_type != crate::model::paragraph::ColumnBreakType::None && !one_column_metadata)
+            || line.vertical_pos != 0 || line.line_height <= 0 || line.line_spacing < 0
+        { return false; }
+        let pad = cell.effective_padding(&table.padding);
+        if pad.top < 0 || pad.bottom < 0 { return false; }
+        let cell_height = i64::from(line.line_height) + i64::from(pad.top) + i64::from(pad.bottom);
+        let mut inline_owner = None;
+        let mut column_metadata = 0;
+        for control in &para.controls {
+            match control {
+                Control::ColumnDef(columns) if columns.column_count == 1 => {
+                    column_metadata += 1;
+                    if column_metadata > 1 { return false; }
+                },
+                Control::Table(owner) if inline_owner.is_none() => { inline_owner = Some(owner); },
+                _ => return false,
+            }
+        }
+        if let Some(owner) = inline_owner {
+            if !para.text.trim().is_empty() || !owner.common.treat_as_char
+                || owner.common.height == 0 || owner.common.height > i32::MAX as u32
+                || owner.caption.is_some() || owner.common.allow_overlap
+                || owner.outer_margin_top < 0 || owner.outer_margin_bottom < 0
+                || i64::from(owner.common.height) + i64::from(owner.outer_margin_top)
+                    + i64::from(owner.outer_margin_bottom) != i64::from(line.line_height)
+            { return false; }
+            inline_height = inline_height.max(cell_height);
+        }
+        closed_height = closed_height.max(cell_height).max(i64::from(cell.height));
+    }
+    inline_height == measured && closed_height == measured
 }
 
