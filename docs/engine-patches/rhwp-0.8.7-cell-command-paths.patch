+    /// Insert into the exact cell paragraph without a scratch document or clipboard.
+    pub fn create_table_in_cell_by_path_native(
+        &mut self, section_idx: usize, parent_para_idx: usize,
+        path: &[(usize, usize, usize)], char_offset: usize, row_count: u16, col_count: u16,
+        treat_as_char: bool,
+        col_widths_hu: Option<&[u32]>, row_heights_hu: Option<&[u32]>,
+    ) -> Result<String, HwpError> {
+        if row_count == 0 || col_count == 0 || row_count > 256 || col_count > 256 {
+            return Err(HwpError::RenderError("표의 줄과 칸 수는 1~256이어야 합니다".into()));
+        }
+        let source = self.resolve_paragraph_by_path(section_idx, parent_para_idx, path)?.clone();
+        if char_offset > source.text.chars().count() {
+            return Err(HwpError::RenderError("셀의 문자 위치가 범위를 벗어났습니다".into()));
+        }
+        let owner = self.resolve_table_by_path(section_idx, parent_para_idx, path)?;
+        let cell = self.resolve_cell_by_path(section_idx, parent_para_idx, path)?;
+        let padding = cell.effective_padding(&owner.padding);
+        let width = (i64::from(cell.width) - i64::from(padding.left) - i64::from(padding.right))
+            .clamp(1, i64::from(u32::MAX)) as u32;
+        let mut table = self.build_inline_table_model(section_idx, &source, char_offset,
+            row_count, col_count, col_widths_hu, row_heights_hu, Some(width))?;
+        table.common.treat_as_char = treat_as_char;
+        let raw = &mut table.raw_ctrl_data[common_obj_offsets::FLAGS];
+        let mut flags = u32::from_le_bytes(raw.try_into().unwrap());
+        flags = if treat_as_char { flags | 1 } else { flags & !1 };
+        raw.copy_from_slice(&flags.to_le_bytes());
+        let para = self.get_cell_paragraph_mut_by_path(section_idx, parent_para_idx, path)?;
+        let control_idx = Self::insert_inline_table_model(para, table, char_offset);
+        self.reflow_cell_paragraph_by_path(section_idx, parent_para_idx, path, path.last().unwrap().2);
+        self.mark_cell_control_dirty(section_idx, parent_para_idx, path[0].0);
+        self.document.sections[section_idx].raw_stream = None;
+        self.mark_section_dirty(section_idx);
+        self.paginate_if_needed();
+        Ok(serde_json::json!({"ok":true,"paraIdx":parent_para_idx,"controlIdx":control_idx}).to_string())
+    }
