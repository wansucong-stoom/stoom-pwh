+    /// All structural edits resolve the same immutable table path as property edits.
+    pub fn edit_table_structure_by_path_native(
+        &mut self, section_idx: usize, parent_para_idx: usize,
+        path: &[(usize, usize, usize)], json: &str,
+    ) -> Result<String, HwpError> {
+        #[derive(serde::Deserialize)]
+        #[serde(rename_all="camelCase", deny_unknown_fields)]
+        struct Edit {
+            operation: String,
+            #[serde(default)] row: u16, #[serde(default)] col: u16,
+            #[serde(default)] end_row: u16, #[serde(default)] end_col: u16,
+            #[serde(default="one")] count: u16,
+            #[serde(default="one")] rows: u16, #[serde(default="one")] cols: u16,
+            #[serde(default)] equal_row_height: bool, #[serde(default)] merge_first: bool,
+        }
+        fn one() -> u16 { 1 }
+        let edit: Edit = serde_json::from_str(json).map_err(|e| HwpError::RenderError(e.to_string()))?;
+        if edit.count == 0 || edit.count > 256 || edit.rows == 0 || edit.rows > 256
+            || edit.cols == 0 || edit.cols > 256 {
+            return Err(HwpError::RenderError("줄·칸 수가 범위를 벗어났습니다".into()));
+        }
+        let (rows, cols, count) = {
+            let table = self.resolve_table_mut_by_cell_path(section_idx, parent_para_idx, path)?;
+            // Validate every mutation on a table clone before replacing the live table.
+            // A multi-insert or merged-cell failure cannot leave a partial edit.
+            let mut changed = table.clone();
+            let result = match edit.operation.as_str() {
+                "insert-row-above" | "insert-row-below" => {
+                    if u32::from(changed.row_count)+u32::from(edit.count)>256 {
+                        return Err(HwpError::RenderError("표는 최대 256줄까지 지원합니다".into()));
+                    }
+                    (0..edit.count).try_for_each(|_| changed.insert_row(edit.row,edit.operation.ends_with("below")))
+                },
+                "insert-col-left" | "insert-col-right" => {
+                    if u32::from(changed.col_count)+u32::from(edit.count)>256 {
+                        return Err(HwpError::RenderError("표는 최대 256칸까지 지원합니다".into()));
+                    }
+                    (0..edit.count).try_for_each(|_| changed.insert_column(edit.col,edit.operation.ends_with("right")))
+                },
+                "delete-row" => changed.delete_row(edit.row),
+                "delete-col" => changed.delete_column(edit.col),
+                "merge-cells" => changed.merge_cells(edit.row,edit.col,edit.end_row,edit.end_col),
+                "split-cell" => changed.split_cell(edit.row,edit.col),
+                "split-cell-into" => changed.split_cell_into(edit.row,edit.col,edit.rows,edit.cols,edit.equal_row_height,edit.merge_first),
+                "split-cells-in-range" if edit.merge_first => changed.merge_cells(edit.row,edit.col,edit.end_row,edit.end_col)
+                    .and_then(|_| changed.split_cell_into(edit.row,edit.col,edit.rows,edit.cols,edit.equal_row_height,false)),
+                "split-cells-in-range" => changed.split_cells_in_range(edit.row,edit.col,edit.end_row,edit.end_col,edit.rows,edit.cols,edit.equal_row_height),
+                _ => return Err(HwpError::RenderError("지원하지 않는 표 편집 명령입니다".into())),
+            };
+            result.map_err(HwpError::RenderError)?;
+            *table=changed;
+            (table.row_count,table.col_count,table.cells.len())
+        };
+        // Width and paragraph ownership may change after merge/split/column edits.
+        // Reflow only paragraphs in this table; ancestors keep their own source data.
+        let paragraph_counts: Vec<usize> = self.resolve_table_by_path(section_idx,parent_para_idx,path)?
+            .cells.iter().map(|cell|cell.paragraphs.len()).collect();
+        for (cell, paragraphs) in paragraph_counts.into_iter().enumerate() {
+            let mut owned=path.to_vec();
+            let last=owned.last_mut().unwrap();
+            last.1=cell;
+            for paragraph in 0..paragraphs {
+                owned.last_mut().unwrap().2=paragraph;
+                self.reflow_cell_paragraph_by_path(section_idx,parent_para_idx,&owned,paragraph);
+            }
+        }
+        self.mark_cell_control_dirty(section_idx,parent_para_idx,path[0].0);
+        self.document.sections[section_idx].raw_stream=None;
+        self.mark_section_dirty(section_idx);
+        self.paginate_if_needed();
+        Ok(serde_json::json!({"ok":true,"rowCount":rows,"colCount":cols,"cellCount":count}).to_string())
+    }
