+/// The source cut has already moved the complete float past its host line.
+/// Resolve its zero-offset paragraph anchor before the centered fallback.
+fn resumed_para_left_table_anchor(
+    table: &Table, area: &LayoutRect, table_width: f64, dpi: f64,
+) -> Option<f64> {
+    if table.common.horz_rel_to != HorzRelTo::Para || table.common.horz_align != HorzAlign::Left
+        || table.common.horizontal_offset != 0
+        || table.outer_margin_left < 0 || table.outer_margin_right < 0
+    {
+        return None;
+    }
+    let left = hwpunit_to_px(i32::from(table.outer_margin_left), dpi);
+    let right = hwpunit_to_px(i32::from(table.outer_margin_right), dpi);
+    (table_width > 0.0 && table_width + left + right <= area.width).then_some(area.x + left)
