+
+/// A body note owns one logical slot, regardless of the number of displayed
+/// digits or the width of its editor-only control-code label. This metadata is
+/// taken from typed render markers and the source control, never visible text.
+#[derive(Clone, Copy)]
+struct BodyNoteSpan {
+    sec: usize,
+    para: usize,
+    ci: usize,
+    pos: usize,
+    x: f64,
+    y: f64,
+    w: f64,
+    h: f64,
+}
+
+fn body_note_spans(
+    core: &DocumentCore,
+    root: &crate::renderer::render_tree::RenderNode,
+) -> Vec<BodyNoteSpan> {
+    use crate::renderer::render_tree::{FieldMarkerType, RenderNode, RenderNodeType};
+    fn walk(
+        core: &DocumentCore,
+        node: &RenderNode,
+        out: &mut std::collections::BTreeMap<(usize, usize, usize), BodyNoteSpan>,
+    ) {
+        // These descendants have a different source address space.
+        if matches!(
+            node.node_type,
+            RenderNodeType::Table(_)
+                | RenderNodeType::TextBox
+                | RenderNodeType::Header
+                | RenderNodeType::Footer
+                | RenderNodeType::FootnoteArea
+        ) {
+            return;
+        }
+        let source = match &node.node_type {
+            RenderNodeType::FootnoteMarker(m) => {
+                Some((m.section_index, m.para_index, Some(m.control_index), None))
+            }
+            RenderNodeType::TextRun(tr) if tr.cell_context.is_none() => match tr.field_marker {
+                FieldMarkerType::NoteMarker {
+                    control_index,
+                    logical_offset,
+                } => tr
+                    .section_index
+                    .zip(tr.para_index)
+                    .map(|(s, p)| (s, p, Some(control_index), Some(logical_offset))),
+                _ => None,
+            },
+            _ => None,
+        };
+        if let Some((sec, pi, control, position)) = source {
+            if let Some(para) = core
+                .document
+                .sections
+                .get(sec)
+                .and_then(|s| s.paragraphs.get(pi))
+            {
+                let positions = find_logical_control_positions(para);
+                for (ci, c) in para.controls.iter().enumerate() {
+                    if !matches!(c, Control::Footnote(_) | Control::Endnote(_)) {
+                        continue;
+                    }
+                    let Some(pos) = positions.get(ci).copied() else {
+                        continue;
+                    };
+                    if control.is_some_and(|wanted| wanted != ci)
+                        || position.is_some_and(|wanted| wanted != pos)
+                    {
+                        continue;
+                    }
+                    let b = &node.bbox;
+                    let value = BodyNoteSpan {
+                        sec,
+                        para: pi,
+                        ci,
+                        pos,
+                        x: b.x,
+                        y: b.y,
+                        w: b.width,
+                        h: b.height,
+                    };
+                    out.entry((sec, pi, ci))
+                        .and_modify(|old| {
+                            let right = (old.x + old.w).max(b.x + b.width);
+                            let bottom = (old.y + old.h).max(b.y + b.height);
+                            old.x = old.x.min(b.x);
+                            old.y = old.y.min(b.y);
+                            old.w = right - old.x;
+                            old.h = bottom - old.y;
+                        })
+                        .or_insert(value);
+                }
+            }
+        }
+        for child in &node.children {
+            walk(core, child, out);
+        }
+    }
+    let mut out = std::collections::BTreeMap::new();
+    walk(core, root, &mut out);
+    out.into_values().collect()
 }
 
