+            char_overlap: None,
+            border_fill_id: 0,
+            baseline,
+            field_marker: FieldMarkerType::NoteMarker {
+                control_index: ci,
+                logical_offset: pos,
+            },
+            layout_positions: None,
+            display_text: None,
+        }),
+        BoundingBox::new(x, y, w, h),
+    );
+    Some((node, w))
+}
