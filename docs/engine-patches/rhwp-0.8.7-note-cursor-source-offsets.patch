+    x: f64,
+    y: f64,
+    h: f64,
+    baseline: f64,
+    base: &TextStyle,
+) -> Option<(RenderNode, f64)> {
+    let text = match para.controls.get(ci)? {
+        Control::Footnote(_) => "[각주]",
+        Control::Endnote(_) => "[미주]",
+        _ => return None,
+    };
+    let pos = para.logical_control_positions().get(ci).copied()?;
+    let mut style = base.clone();
+    style.color = 0x0000FF;
+    style.font_size *= 0.55;
+    let w = estimate_text_width(text, &style);
+    let node = RenderNode::new(
+        tree.next_id(),
+        RenderNodeType::TextRun(TextRunNode {
+            text: text.to_string(),
+            style,
+            char_shape_id: None,
+            para_shape_id: Some(para.para_shape_id),
+            section_index: Some(sec),
+            para_index: Some(pi),
+            char_start: None,
+            cell_context: None,
