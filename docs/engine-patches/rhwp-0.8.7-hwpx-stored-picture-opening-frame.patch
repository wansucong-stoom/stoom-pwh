+            ).is_some()) || self.saved_nested_picture_opening_rows(
+            table, 0, row + 1, &[], cut, styles,
+        ).is_some() {
+            return true;
+        }
+        let cells: Vec<_> = Self::row_cut_cell_order(table, row).into_iter()
+            .filter_map(|index| table.cells.get(index)).collect();
+        self.saved_picture_parent_opening_height(table, &cells, &[], cut, styles).is_some()
+    }
