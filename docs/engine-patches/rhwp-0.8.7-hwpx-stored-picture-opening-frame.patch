+    fn stored_plain_cell_paragraph(para: &Paragraph) -> bool {
+        (para.controls.is_empty()
+            || matches!(para.controls.as_slice(), [Control::ColumnDef(c)] if c.column_count == 1))
+            && stored_float_frame_owner_is_original(para)
+    }
