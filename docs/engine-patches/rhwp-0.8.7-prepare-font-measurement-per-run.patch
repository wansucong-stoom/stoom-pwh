+#[derive(Clone, Copy)]
+struct EmbeddedFont<'a> {
+    primary_name: &'a str,
+    kopub_dotum: Option<bool>,
+}
+
+impl<'a> EmbeddedFont<'a> {
+    fn new(font_family: &'a str) -> Self {
+        let primary_name = font_family
+            .split(',')
+            .next()
+            .unwrap_or(font_family)
+            .trim()
+            .trim_matches('\'')
+            .trim_matches('"');
+        let lower = primary_name.to_lowercase();
+        let kopub_dotum = if primary_name.contains("KoPub돋움체") || lower.contains("kopub dotum") {
+            Some(true)
+        } else if primary_name.contains("KoPub바탕체") || lower.contains("kopub batang") {
+            Some(false)
+        } else {
+            None
+        };
+        Self { primary_name, kopub_dotum }
+    }
+}
