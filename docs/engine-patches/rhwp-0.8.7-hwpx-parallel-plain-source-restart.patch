+    /// Two independent cells can prove one page boundary even if their
+    /// line advances differ or one restarts inside a paragraph.
+    fn saved_parallel_plain_restart_cut(
+        &self, table: &crate::model::table::Table, row: usize, styles: &ResolvedStyleSet,
+    ) -> Option<RowCut> {
+        let profile = self.profile.get();
+        if !profile.hwpx_stored_layout() || profile.hwp5_origin_hwpx() || profile.session_edited()
+            || table.common.treat_as_char || table.page_break != TablePageBreak::RowBreak
+            || self.render_normalization.borrow().table_text_reflowed(table)
+            || Self::row_has_prior_rowspan_cover(table, row)
+        { return None; }
+        let order = Self::row_cut_cell_order(table, row);
+        if order.len() < 2 || order.len() != usize::from(table.col_count) { return None; }
+        let mut cut = Vec::with_capacity(order.len());
+        let mut owners = 0;
+        for index in order {
+            let cell = &table.cells[index];
+            if cell.row_span != 1 || cell.col_span != 1 || cell.dirty_flag || cell.text_direction != 0
+                || !cell.paragraphs.iter().all(Self::stored_plain_cell_paragraph)
+            { return None; }
+            let units = self.cell_units(cell, table, styles);
+            if units.is_empty() { return None; }
+            let mut previous: Option<&crate::model::paragraph::LineSeg> = None;
+            let mut restart = None;
+            for (at, unit) in units.iter().enumerate() {
+                if unit.nested_row.is_some() || unit.mixed_nested_fragment
+                    || unit.non_inline_control_range.is_some() || unit.vis_end != unit.vis_start + 1
+                { return None; }
+                let line = cell.paragraphs.get(unit.para_idx)?.line_segs.get(unit.vis_start)?;
+                if line.line_height <= 0 || line.line_spacing < 0 || line.segment_width <= 0 {
+                    return None;
+                }
+                let expected = previous.map_or(0, |prev| i64::from(prev.vertical_pos)
+                    + i64::from(prev.line_height) + i64::from(prev.line_spacing));
+                if i64::from(line.vertical_pos) != expected {
+                    let before = previous?;
+                    if restart.is_some() || !unit.page_frame_reset_before
+                        || before.vertical_pos <= 0 || line.vertical_pos != 0
+                        || before.column_start != line.column_start
+                        || before.segment_width != line.segment_width
+                    { return None; }
+                    restart = Some(at);
+                    owners += 1;
+                }
+                previous = Some(line);
+            }
+            cut.push(restart.unwrap_or(units.len()));
+        }
+        (owners >= 2).then_some(cut)
+    }
+
+    pub(super) fn saved_parallel_plain_restart_boundary(
+        &self, table: &crate::model::table::Table, row: usize, cut: &[usize], styles: &ResolvedStyleSet,
+    ) -> bool {
+        !cut.is_empty() && self.saved_parallel_plain_restart_cut(table, row, styles)
+            .is_some_and(|source| source == cut)
+    }
