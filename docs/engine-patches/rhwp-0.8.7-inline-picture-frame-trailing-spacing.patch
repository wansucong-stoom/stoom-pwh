+    /// A saved split cell can end its physical frame on an inline picture.
+    /// The picture occupies the saved line box; spacing after that box belongs
+    /// to same-frame flow and must not push the picture across a stored reset.
+    fn inline_picture_closes_stored_cell_frame(
+        &self,
+        cell: &crate::model::table::Cell,
+        table: &crate::model::table::Table,
+        paragraph_index: usize,
+    ) -> bool {
+        let profile = self.profile.get();
+        if !profile.hwpx_container()
+            || !profile.hwpx_stored_layout()
+            || table.common.treat_as_char
+            || !matches!(table.page_break, crate::model::table::TablePageBreak::RowBreak)
+            || table.row_count != 1
+            || table.col_count != 1
+            || cell.height <= table.common.height
+            || cell.dirty_flag
+        {
+            return false;
+        }
+        let Some((paragraph, following)) = cell.paragraphs.get(paragraph_index)
+            .zip(cell.paragraphs.get(paragraph_index + 1))
+        else {
+            return false;
+        };
+        let ([Control::Picture(picture)], [line], Some(next)) = (
+            paragraph.controls.as_slice(),
+            paragraph.line_segs.as_slice(),
+            following.line_segs.first(),
+        ) else {
+            return false;
+        };
+        let synthetic = crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY;
+        if !paragraph.text.trim().is_empty()
+            || !picture.common.treat_as_char
+            || !picture.common.flow_with_text
+            || picture.common.allow_overlap
+            || paragraph.stored_text_partition_is_dirty()
+            || following.stored_text_partition_is_dirty()
+            || (following.text.trim().is_empty() && following.controls.is_empty())
+            || (line.tag | next.tag) & synthetic != 0
+            || line.vertical_pos <= 0
+            || next.vertical_pos < 0
+            || next.vertical_pos >= line.vertical_pos
+            || line.line_height <= 0
+            || line.line_spacing <= 0
+            || picture.common.height != line.line_height as u32
+        {
+            return false;
+        }
+        let end = i64::from(line.vertical_pos)
+            + i64::from(line.line_height)
+            + i64::from(cell.effective_vertical_padding_hu(&table.padding));
+        let frame = i64::from(table.common.height);
+        end <= frame && end + i64::from(line.line_spacing) > frame
+    }
