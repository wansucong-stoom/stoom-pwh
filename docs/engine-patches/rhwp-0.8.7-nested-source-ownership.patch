     /// content.  Direct HWPX RowBreak tables use the opposite empty cell as a
     /// structural band; a stored frame rewind in the sole visible cell must
     /// therefore not be erased by the whole-row fast path.
+    /// Inspect an authoritative child RowCut without converting its cursor
+    /// into a pixel offset. Completed label cells do not own the continuation.
+    ///
+    /// Some(true): every remaining visible owner begins at an original plain
+    /// text paragraph frame rewind. Some(false): at least one supported owner
+    /// continues an ordinary source line. None: the cut contains unsupported
+    /// source owners (nested/mixed/control units, spans or synthetic geometry),
+    /// so this helper cannot authorize a physical page boundary.
+    ///
+    /// This proves source-owner synchronization, not that capacity measurement
+    /// on the preceding page was correct. Callers must preserve this provenance
+    /// separately from the ordinary raw-reset and measured-height flags.
+    pub(super) fn nested_row_cut_plain_source_frame_boundary(
+        &self,
+        table: &crate::model::table::Table,
+        row: usize,
+        start_cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> Option<bool> {
+        let cells: Vec<_> = Self::row_cut_cell_order(table, row)
+            .into_iter()
+            .filter_map(|index| table.cells.get(index))
+            .collect();
+        if cells.is_empty()
+            || start_cut.len() != cells.len()
+            || cells.iter().any(|cell| cell.row_span != 1)
+            || table.cells.iter().any(|cell| {
+                let first = usize::from(cell.row);
+                first < row && row < first + usize::from(cell.row_span)
+            })
+        {
+            return None;
+        }
+        let authentic = |segment: &crate::model::paragraph::LineSeg| {
+            segment.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+        };
+        let unsupported = |unit: &CellUnit| {
+            unit.nested_row.is_some()
+                || unit.nested_table_fragment.is_some()
+                || unit.mixed_nested_fragment
+                || unit.non_inline_control_range.is_some()
+        };
+        let mut remaining_owners = 0usize;
+        let mut all_restarted = true;
+        for (cell, &cursor) in cells.iter().zip(start_cut) {
+            if cell.paragraphs.iter().any(|paragraph| {
+                paragraph.stored_text_partition_is_dirty() || paragraph.cell_format_vpos_dirty
+            }) {
+                return None;
+            }
+            let units = self.cell_units(cell, table, styles);
+            if cursor > units.len() {
+                return None;
+            }
+            // Future nested content keeps this cell active, but does not
+            // invalidate a preceding plain-text frame owner in the same cell.
+            // A nested/control unit at the cursor itself is inconclusive.
+            let first_visible = units[cursor..].iter().position(|unit| {
+                !unit.empty_spacer
+                    && (unsupported(unit) || unit.vis_start < unit.vis_end)
+                    && Self::cell_unit_has_visible_content(cell, unit)
+            }).map(|offset| cursor + offset);
+            let Some(index) = first_visible else {
+                continue; // This sibling's source content is already consumed.
+            };
+            if units[cursor..index].iter().any(|unit| {
+                unit.hard_break_before || unit.page_frame_reset_before
+                    || unit.stored_frame_break_before
+            }) {
+                return None; // Do not step across a separate source owner.
+            }
+            remaining_owners += 1;
+            let current = &units[index];
+            if unsupported(current) {
+                return None;
+            }
+            if current.vis_start != 0 || current.para_idx == 0 {
+                all_restarted = false;
+                continue;
+            }
+            let paragraph = cell.paragraphs.get(current.para_idx)?;
+            let previous_paragraph = cell.paragraphs.get(current.para_idx - 1)?;
+            if paragraph.text.trim().is_empty() || previous_paragraph.text.trim().is_empty()
+                || !paragraph.controls.is_empty() || !previous_paragraph.controls.is_empty()
+            {
+                return None;
+            }
+            let next_segment = paragraph.line_segs.first()?;
+            let previous_segment = previous_paragraph.line_segs.last()?;
+            if !authentic(next_segment) || !authentic(previous_segment) {
+                return None;
+            }
+            let Some(previous_unit) = index.checked_sub(1).and_then(|i| units.get(i)) else {
+                all_restarted = false;
+                continue;
+            };
+            if unsupported(previous_unit)
+                || previous_unit.para_idx + 1 != current.para_idx
+                || previous_unit.vis_end != previous_paragraph.line_segs.len()
+            {
+                return None;
+            }
+            all_restarted &= previous_segment.vertical_pos > 0
+                && next_segment.vertical_pos == 0;
+        }
+        (remaining_owners > 0).then_some(all_restarted)
+    }
