+/// A projected nested table owns only its nested atoms, not every text line in
+/// the same source paragraph. None preserves legacy atomic-table handling.
+fn projected_table_owner_in_cut(
+    units: &[CellUnit],
+    para_idx: usize,
+    start: usize,
+    end: usize,
+) -> Option<bool> {
+    let is_table_atom = |unit: &CellUnit| {
+        unit.para_idx == para_idx
+            && (unit.nested_row.is_some()
+                || unit.nested_table_fragment.is_some()
+                || unit.mixed_nested_fragment)
+    };
+    if !units.iter().any(&is_table_atom) {
+        return None;
+    }
+    let start = start.min(units.len());
+    let end = end.min(units.len()).max(start);
+    Some(units[start..end].iter().any(is_table_atom))
 }
 
