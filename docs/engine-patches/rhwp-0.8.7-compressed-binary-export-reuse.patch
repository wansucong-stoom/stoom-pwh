+// Pwh bounded compressed-entry reuse. Keys cover the complete, normalized
+// payload (including restored OLE prefixes), never document-local image IDs.
+// Only archives produced by this writer are raw-copied: source ZIP metadata,
+// CRCs, resource limits and content-loss checks are never bypassed.
+const COMPRESSED_CACHE_BYTES: usize = 32 * 1024 * 1024;
+const COMPRESSED_CACHE_ENTRIES: usize = 64;
+const COMPRESSED_CACHE_INPUT_BYTES: usize = 32 * 1024 * 1024;
+#[derive(PartialEq, Eq)]
+struct CompressedEntryKey { digest: [u8; 32], len: usize, name: String }
+struct CompressedEntry { key: CompressedEntryKey, archive: Arc<[u8]> }
+thread_local! {
+    static COMPRESSED_ENTRY_CACHE: std::cell::RefCell<Vec<CompressedEntry>> = const {
+        std::cell::RefCell::new(Vec::new())
+    };
+}
+fn compressed_entry(key: &CompressedEntryKey) -> Option<Arc<[u8]>> {
+    COMPRESSED_ENTRY_CACHE.with(|cache| {
+        let mut entries = cache.borrow_mut();
+        let index = entries.iter().position(|entry| &entry.key == key)?;
+        let entry = entries.remove(index);
+        let result = Arc::clone(&entry.archive);
+        entries.push(entry);
+        Some(result)
+    })
+}
+fn retain_compressed_entry(key: CompressedEntryKey, archive: Arc<[u8]>) {
+    if archive.len() > COMPRESSED_CACHE_BYTES { return; }
+    COMPRESSED_ENTRY_CACHE.with(|cache| {
+        let mut entries = cache.borrow_mut();
+        entries.retain(|entry| entry.key != key);
+        let mut size: usize = entries.iter().map(|entry| entry.archive.len()).sum();
+        while !entries.is_empty()
+            && (size + archive.len() > COMPRESSED_CACHE_BYTES
+                || entries.len() >= COMPRESSED_CACHE_ENTRIES)
+        {
+            size -= entries.remove(0).archive.len();
+        }
+        entries.push(CompressedEntry { key, archive });
+    });
+}
+// End Pwh bounded compressed-entry reuse.
 
