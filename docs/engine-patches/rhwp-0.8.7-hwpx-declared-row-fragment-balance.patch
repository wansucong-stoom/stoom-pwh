+    /// A fixed row declaration can belong to several physical fragments.
+    /// Require a complete original coordinate ladder and one continuing cell;
+    /// the other cells must have finished before its first saved restart.
+    fn saved_declared_nested_row_frames(
+        &self, table: &crate::model::table::Table, row: usize, styles: &ResolvedStyleSet,
+    ) -> Option<(f64, usize, Vec<(RowCut, f64)>)> {
+        let profile = self.profile.get();
+        if !profile.hwpx_stored_layout() || profile.hwp5_origin_hwpx() || profile.session_edited()
+            || !crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            || table.page_break != TablePageBreak::RowBreak || table.caption.is_some()
+            || Self::row_has_prior_rowspan_cover(table, row)
+            || self.render_normalization.borrow().table_text_reflowed(table)
+        { return None; }
+        let order = Self::row_cut_cell_order(table, row);
+        if order.len() != usize::from(table.col_count) { return None; }
+        let requested = hwpunit_to_px(i32::try_from(table.cells[*order.first()?].height).ok()?, self.dpi);
+        let original = table.cells[*order.first()?].height;
+        if requested <= 0.0 { return None; }
+        let mut owner = None;
+        let mut peer_min = 0.0f64;
+        let mut complete = Vec::with_capacity(order.len());
+        for (index, &cell_idx) in order.iter().enumerate() {
+            let cell = &table.cells[cell_idx];
+            if cell.dirty_flag || cell.height != original || cell.row_span != 1
+                || cell.col_span != 1 || cell.text_direction != 0
+            { return None; }
+            let units = self.cell_units(cell, table, styles);
+            complete.push(units.len());
+            let (_, _, top, bottom) = self.resolve_cell_padding(cell, table);
+            let frame_height = |ink: i64| top + ink as f64 * self.dpi / 7200.0 + bottom;
+            let frames = Self::saved_cell_source_frames(cell)?;
+            if let [(_, ink)] = frames.as_slice() {
+                peer_min = peer_min.max(frame_height(*ink));
+                continue;
+            }
+            if owner.is_some() { return None; }
+            let cuts = frames.into_iter().map(|(paragraph, ink)| {
+                let cursor = units.iter().position(|u| u.para_idx == paragraph)?;
+                let start = units.get(cursor)?;
+                if start.nested_row.is_some() || start.vis_start != 0
+                    || (cursor != 0 && !start.page_frame_reset_before)
+                { return None; }
+                Some((cursor, frame_height(ink)))
+            }).collect::<Option<Vec<_>>>()?;
+            owner = Some((index, cell_idx, cuts));
+        }
+        let (column, cell_idx, cuts) = owner?;
+        let frames = cuts.into_iter().enumerate().map(|(i, (cursor, height))| {
+            let mut cut = if i == 0 { vec![0; order.len()] } else { complete.clone() };
+            cut[column] = cursor;
+            (cut, if i == 0 { height.max(peer_min) } else { height })
+        }).collect::<Vec<_>>();
+        (frames.iter().map(|(_, height)| height).sum::<f64>() <= requested)
+            .then_some((requested, cell_idx, frames))
+    }
