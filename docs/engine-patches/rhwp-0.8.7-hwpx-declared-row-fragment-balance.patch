+    /// The original anchor and the next stored line must close the same
+    /// floating object box before the object can contribute to a row frame.
+    pub(super) fn saved_row_frame_float_advance(
+        host: &Paragraph, successor: &Paragraph, child: &crate::model::table::Table,
+    ) -> Option<i64> {
+        if !Self::stored_nested_outer_margin_host(host, child)
+            || !crate::renderer::float_placement::is_para_topbottom_float(&child.common)
+            || child.common.height == 0 || child.common.height > i32::MAX as u32
+            || (child.common.vertical_offset as i32) < 0
+            || child.outer_margin_top < 0 || child.outer_margin_bottom < 0
+            || !stored_float_frame_owner_is_original(host)
+        { return None; }
+        let origin = i64::from(host.line_segs.first()?.vertical_pos);
+        let advance = i64::from(child.common.height)
+            + i64::from(child.common.vertical_offset as i32)
+            + i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom);
+        (origin + advance == i64::from(successor.line_segs.first()?.vertical_pos)).then_some(advance)
+    }
