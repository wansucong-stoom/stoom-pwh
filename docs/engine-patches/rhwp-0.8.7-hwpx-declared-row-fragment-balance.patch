+    pub(super) fn saved_declared_frame_cell_ink(
+        &self, table: &crate::model::table::Table, row: usize, cell: usize, start: &[usize],
+        end: &[usize], styles: &ResolvedStyleSet,
+    ) -> Option<f64> {
+        let (_, owner, frames) = self.saved_declared_nested_row_frames(table, row, styles)?;
+        if cell != owner { return None; }
+        let i = frames.iter().position(|(cut, _)| cut == start || (start.is_empty() && cut.iter().all(|&u| u == 0)))?;
+        if frames.get(i + 1).map_or(!end.is_empty(), |(next, _)| next != end) { return None; }
+        let cell = &table.cells[cell];
+        let column = Self::row_cut_cell_order(table, row).iter()
+            .position(|&index| std::ptr::eq(&table.cells[index], cell))?;
+        let units = self.cell_units(cell, table, styles);
+        let paragraph = units.get(frames[i].0[column])?.para_idx;
+        let (_, ink) = Self::saved_cell_source_frames(cell)?.into_iter().find(|&(start, _)| start == paragraph)?;
+        Some(ink as f64 * self.dpi / 7200.0)
+    }
