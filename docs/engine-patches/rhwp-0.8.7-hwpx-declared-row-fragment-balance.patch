+    fn saved_cell_source_frames(cell: &crate::model::table::Cell) -> Option<Vec<(usize, i64)>> {
+        let mut frames = Vec::new();
+        let mut start = 0;
+        let mut expected = 0;
+        let mut ink = 0;
+        for (index, para) in cell.paragraphs.iter().enumerate() {
+            if !stored_float_frame_owner_is_original(para) { return None; }
+            let origin = i64::from(para.line_segs.first()?.vertical_pos);
+            if origin == 0 && expected > 0 {
+                if ink <= 0 { return None; }
+                frames.push((start, ink));
+                start = index;
+                expected = 0;
+            }
+            if origin != expected { return None; }
+            if let [Control::Table(child)] = para.controls.as_slice() {
+                expected += Self::saved_row_frame_float_advance(
+                    para, cell.paragraphs.get(index + 1)?, child,
+                )?;
+                ink = expected;
+                continue;
+            }
+            if !Self::stored_plain_cell_paragraph(para) { return None; }
+            for line in &para.line_segs {
+                if i64::from(line.vertical_pos) != expected || line.line_height <= 0 || line.line_spacing < 0 {
+                    return None;
+                }
+                ink = expected + i64::from(line.line_height);
+                expected = ink + i64::from(line.line_spacing);
+            }
+        }
+        if ink <= 0 { return None; }
+        frames.push((start, ink));
+        Some(frames)
+    }
