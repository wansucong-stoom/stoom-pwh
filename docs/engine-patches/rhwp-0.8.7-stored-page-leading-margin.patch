+/// 저장 첫 줄이 단일 TAC 표의 바깥 상자를 완전히 소유하는 경우의 쪽 앞 간격.
+/// 문단 항목 없이 표 항목이 단을 시작해도 측정과 배치가 같은 증거를 쓴다.
+pub(crate) fn stored_tac_column_start_lead(
+    para: &Paragraph,
+    next: Option<&Paragraph>,
+    table: &crate::model::table::Table,
+    styles: &ResolvedStyleSet,
+    dpi: f64,
+) -> Option<f64> {
+    if !table.common.treat_as_char || !para.text.is_empty() || para.line_segs.len() != 1 {
+        return None;
+    }
+    let mut table_count = 0;
+    for control in &para.controls {
+        match control {
+            Control::Table(_) => table_count += 1,
+            marker if crate::renderer::composer::control_is_width_neutral_marker(marker) => {},
+            _ => return None,
+        }
+    }
+    let line = &para.line_segs[0];
+    let outer_height = i64::from(table.common.height)
+        + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom);
+    if table_count != 1 || (i64::from(line.line_height) - outer_height).abs() > 1
+        || !stored_first_margin_is_page_relative(para, next, styles, dpi)
+    {
+        return None;
+    }
+    Some(hwpunit_to_px(line.vertical_pos, dpi))
 }
 
