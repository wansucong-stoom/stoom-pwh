+/// A single source line owns an entire inline table when its occupied box
+/// and the following source origin agree with the paragraph style.
+fn saved_single_inline_table_band(
+    para: &Paragraph,
+    table: &crate::model::table::Table,
+    following: &Paragraph,
+    spacing_after: f64,
+    col_area: &LayoutRect,
+    dpi: f64,
+) -> Option<(f64, f64)> {
+    use crate::model::paragraph::LineSeg;
+    if !table.common.treat_as_char || table.caption.is_some()
+        || !matches!(table.common.text_wrap, TextWrap::TopAndBottom)
+        || table.outer_margin_top < 0 || table.outer_margin_bottom < 0
+        || !para.text.trim().is_empty()
+        || para.stored_text_partition_is_dirty() || para.source_frame_reflowed
+        || following.stored_text_partition_is_dirty() || following.source_frame_reflowed
+        || !matches!(para.controls.as_slice(), [Control::Table(owner)] if std::ptr::eq(owner.as_ref(), table))
+    {
+        return None;
+    }
+    let [line] = para.line_segs.as_slice() else { return None; };
+    let next = following.line_segs.first()?;
+    let height = i64::from(table.common.height)
+        + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom);
+    let gap = hwpunit_to_px(next.vertical_pos.checked_sub(line.vertical_pos)?, dpi);
+    if line.vertical_pos <= 0 || height <= 0 || line.line_spacing < 0
+        || i64::from(line.line_height) != height || i64::from(line.text_height) != height
+        || [line, next].iter().any(|l| l.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+        || (gap - hwpunit_to_px(i32::try_from(height).ok()?.checked_add(line.line_spacing)?, dpi)
+            - spacing_after).abs() > hwpunit_to_px(1, dpi)
+    {
+        return None;
+    }
+    let start = hwpunit_to_px(line.vertical_pos, dpi);
+    let end = hwpunit_to_px(next.vertical_pos, dpi);
+    (end > start && end <= col_area.height).then_some((
+        col_area.y + start + hwpunit_to_px(i32::from(table.outer_margin_top), dpi),
+        col_area.y + end,
+    ))
 }
 
