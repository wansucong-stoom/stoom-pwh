+    /// A geometry query must not construct unrelated pages just to discover that
+    /// their table belongs to another control. Pagination is authoritative for
+    /// explicit table items; paragraph/shape/wrap placements stay conservative.
+    pub(crate) fn table_query_page_is_candidate(
+        &self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        control_idx: usize,
+        global_page: usize,
+    ) -> bool {
+        use crate::renderer::pagination::PageItem;
+        let mut offset = 0;
+        for (sec, pagination) in self.pagination.iter().enumerate() {
+            if global_page >= offset + pagination.pages.len() {
+                offset += pagination.pages.len();
+                continue;
+            }
+            if sec != section_idx {
+                return false;
+            }
+            if pagination.pre_emitted_host_paras.contains(&parent_para_idx)
+                || pagination.hidden_empty_paras.contains(&parent_para_idx)
+            {
+                return true;
+            }
+            // Global wrap ownership may route a paragraph through its host.
+            // Keep the old exhaustive path whenever this association is present.
+            if pagination.wrap_around_paras.iter().any(|p|
+                p.para_index == parent_para_idx || p.table_para_index == parent_para_idx)
+            {
+                return true;
+            }
+            let page = &pagination.pages[global_page - offset];
+            return page.column_contents.iter().any(|column| {
+                column.wrap_around_paras.iter().any(|p|
+                    p.para_index == parent_para_idx || p.table_para_index == parent_para_idx)
+                    || column.items.iter().any(|item| match item {
+                        PageItem::Table { para_index, control_index }
+                        | PageItem::PartialTable { para_index, control_index, .. } =>
+                            *para_index == parent_para_idx && *control_index == control_idx,
+                        PageItem::FullParagraph { para_index }
+                        | PageItem::PartialParagraph { para_index, .. }
+                        | PageItem::Shape { para_index, .. } => *para_index == parent_para_idx,
+                        PageItem::EndnoteSeparator { .. } => false,
+                    })
+            });
+        }
+        // Preserve the existing renderer error for an invalid global page.
+        true
+    }
