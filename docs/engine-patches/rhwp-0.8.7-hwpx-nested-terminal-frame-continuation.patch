+            && !self.profile.get().session_edited()
+            && unit.vis_start == 0
+            && unit.para_idx + 1 == cell.paragraphs.len()
+            && (unit.nested_row.is_none() || unit.nested_row == Some(0)
+                && unit.nested_table_fragment.as_ref().is_none_or(|cut|
+                    cut.start_cut.iter().all(|&cursor| cursor == 0)))
