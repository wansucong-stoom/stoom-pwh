+                let closed_height = i64::from(child.common.height)
+                    + i64::from(child.outer_margin_top) + i64::from(child.outer_margin_bottom);
+                let previous = unit.para_idx.checked_sub(1)
+                    .and_then(|index| cell.paragraphs.get(index));
+                let prior = unit.para_idx.checked_sub(2)
+                    .and_then(|index| cell.paragraphs.get(index))
+                    .and_then(|paragraph| paragraph.line_segs.last());
+                if line.vertical_pos == 0
+                    && i64::from(line.line_height) == closed_height
+                    && previous.is_some_and(|paragraph| {
+                        Self::stored_plain_cell_paragraph(paragraph)
+                            && !paragraph.text.trim().is_empty()
+                            && matches!(paragraph.line_segs.as_slice(), [last]
