+    /// A zero-width host can start a physical page with a floating table.
+    /// The first blank paragraph below it independently closes the object
+    /// box, and the following text confirms that the new origin continues.
+    pub(super) fn saved_anchored_float_restart_boundary(
+        &self, table: &crate::model::table::Table, row: usize, cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> bool {
+        let profile = self.profile.get();
+        if !profile.hwpx_stored_layout() || profile.hwp5_origin_hwpx() || profile.session_edited()
+            || table.common.treat_as_char || table.page_break != TablePageBreak::RowBreak
+            || self.render_normalization.borrow().table_text_reflowed(table)
+            || Self::row_has_prior_rowspan_cover(table, row)
+        {
+            return false;
+        }
+        let order = Self::row_cut_cell_order(table, row);
+        if order.len() != cut.len() || order.len() != usize::from(table.col_count) { return false; }
+        let mut owner_found = false;
+        for (index, &cursor) in order.into_iter().zip(cut) {
+            let cell = &table.cells[index];
+            let units = self.cell_units(cell, table, styles);
+            if cell.row_span != 1 || cell.dirty_flag { return false; }
+            if cursor == units.len() && Self::saved_plain_cell_end_hu(cell).is_some() { continue; }
+            let Some(unit) = units.get(cursor) else { return false; };
+            if owner_found || unit.vis_start != 0 || !unit.hard_break_before
+                || unit.nested_row.is_some_and(|r| r != 0)
+                || unit.nested_table_fragment.as_ref().is_some_and(|f| f.start_cut.iter().any(|&v| v != 0))
+            { return false; }
+            let Some(before) = unit.para_idx.checked_sub(2) else { return false; };
+            let Some([prior, previous, host, blank, successor]) =
+                cell.paragraphs.get(before..=unit.para_idx + 2) else { return false; };
+            let [Control::Table(child)] = host.controls.as_slice() else { return false; };
+            let ([a], [b], [origin], [end], [next]) = (
+                prior.line_segs.as_slice(), previous.line_segs.as_slice(), host.line_segs.as_slice(),
+                blank.line_segs.as_slice(), successor.line_segs.as_slice(),
+            ) else { return false; };
+            let offset = signed_hwpunit(child.common.vertical_offset);
+            let declared = i64::from(child.common.height) + i64::from(child.outer_margin_top)
+                + i64::from(child.outer_margin_bottom);
+            let advance = |line: &crate::model::paragraph::LineSeg|
+                i64::from(line.vertical_pos) + i64::from(line.line_height) + i64::from(line.line_spacing);
+            if !Self::stored_nested_outer_margin_host(host, child)
+                || !stored_float_frame_owner_is_original(host)
+                || !crate::renderer::float_placement::is_para_topbottom_float(&child.common)
+                || child.common.treat_as_char || child.outer_margin_top < 0 || child.outer_margin_bottom < 0
+                || origin.vertical_pos != 0 || offset <= 0 || declared <= 0
+                || ![prior, previous, blank, successor].into_iter().all(Self::stored_plain_cell_paragraph)
+                || prior.text.trim().is_empty() || previous.text.trim().is_empty()
+                || !blank.text.trim().is_empty() || successor.text.trim().is_empty()
+                || [a,b,end,next].iter().any(|line| line.line_height <= 0 || line.line_spacing < 0)
+                || a.vertical_pos <= 0 || advance(a) != i64::from(b.vertical_pos)
+                || declared + i64::from(offset) != i64::from(end.vertical_pos)
+                || advance(end) != i64::from(next.vertical_pos)
+                || (declared as f64 * self.dpi / 7200.0
+                    - self.calc_nested_table_height(child, styles)).abs() > 0.5
+            {
+                return false;
+            }
+            owner_found = true;
+        }
+        owner_found
