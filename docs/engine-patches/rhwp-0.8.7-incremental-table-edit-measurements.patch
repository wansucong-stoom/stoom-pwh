 /// 높이 측정 엔진
+// Nested controls can be visited several times by one measurement pass: row
+// floors, wrapper tables and occupied-height checks all ask for the same data.
+type NestedMeasurementKey = (usize, usize, u64);
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+pub(crate) struct TableRowGeometryKey {
+    pub(crate) owner: usize,
+    pub(crate) columns: usize,
+    pub(crate) rows: usize,
+    pub(crate) relaxed_padding: bool,
+    pub(crate) allow_declared_trust: bool,
+    pub(crate) frame: [u64; 6],
+}
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+pub(crate) struct CellLineKey {
+    pub(crate) owner: usize,
+    pub(crate) inner_width: u64,
+    pub(crate) dpi: u64,
+    pub(crate) legacy_geometry: bool,
+    pub(crate) repair_overflow: bool,
+}
+
+#[derive(Default)]
+struct NestedMeasurementEntries {
+    cell_lines: std::collections::HashMap<CellLineKey, ComposedParagraph>,
+    measurements: std::collections::HashMap<NestedMeasurementKey, MeasuredTable>,
+    row_geometry: std::collections::HashMap<TableRowGeometryKey, std::sync::Arc<[f64]>>,
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct NestedMeasurements(
+    std::sync::Arc<std::sync::Mutex<NestedMeasurementEntries>>,
+);
+
+impl NestedMeasurements {
+    pub(crate) fn clear(&self) {
+        *self.0.lock().unwrap() = NestedMeasurementEntries::default();
+    }
+
+    pub(crate) fn invalidate_tables(&self, tables: &[usize]) {
+        let mut entries = self.0.lock().unwrap();
+        entries.measurements.retain(|(owner, _, _), _| !tables.contains(owner));
+        entries.row_geometry.retain(|key, _| !tables.contains(&key.owner));
+    }
+
+    pub(crate) fn invalidate_cell_lines(&self, paragraphs: &[usize]) {
+        self.0.lock().unwrap().cell_lines.retain(|key, _| !paragraphs.contains(&key.owner));
+    }
+
+    pub(crate) fn cell_lines(
+        &self,
+        key: CellLineKey,
+        compute: impl FnOnce() -> ComposedParagraph,
+    ) -> ComposedParagraph {
+        let previous = self.0.lock().unwrap().cell_lines.get(&key).cloned();
+        if let Some(composed) = previous {
+            return composed;
+        }
+        let composed = compute();
+        let mut entries = self.0.lock().unwrap();
+        if entries.cell_lines.len() < 8192 {
+            entries.cell_lines.insert(key, composed.clone());
+        }
+        composed
+    }
+
+    pub(crate) fn row_geometry(
+        &self,
+        key: TableRowGeometryKey,
+        compute: impl FnOnce() -> Vec<f64>,
+    ) -> Vec<f64> {
+        let previous = self.0.lock().unwrap().row_geometry.get(&key).cloned();
+        if let Some(rows) = previous {
+            return rows.to_vec();
+        }
+        let rows = compute();
+        let mut entries = self.0.lock().unwrap();
+        if entries.row_geometry.len() < 4096 {
+            entries.row_geometry.insert(key, std::sync::Arc::from(rows.as_slice()));
+        }
+        rows
+    }
+}
