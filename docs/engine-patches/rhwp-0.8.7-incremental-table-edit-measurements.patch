+/// Compare complete page plans after numbering and section inheritance have
+/// been resolved. The edit's host and every continuation must precede the
+/// reusable suffix. Shape or text changes with the same page count still
+/// invalidate any page that depends on the changed host.
+fn reuse_local_table_page_suffix(
+    old: &mut PaginationResult,
+    new: &mut PaginationResult,
+    section: usize,
+    paragraph: usize,
+) -> Option<usize> {
+    use crate::renderer::pagination::PageItem;
+
+    if old.pages.len() != new.pages.len()
+        || !old.endnotes.is_empty()
+        || !new.endnotes.is_empty()
+        || old.wrap_around_paras != new.wrap_around_paras
+        || old.hidden_empty_paras != new.hidden_empty_paras
+        || old.pre_emitted_host_paras != new.pre_emitted_host_paras
+        || old.pre_emitted_host_heights != new.pre_emitted_host_heights
+        || old.pre_emitted_host_content_heights != new.pre_emitted_host_content_heights
+    {
+        return None;
+    }
+    // The renderer replays top-level numbering from preceding pages.
+    let replay_order = |result: &PaginationResult| {
+        let mut seen = std::collections::HashSet::new();
+        result.pages.iter().flat_map(|page| &page.column_contents)
+            .flat_map(|column| &column.items)
+            .filter_map(|item| match item {
+                PageItem::FullParagraph { para_index }
+                | PageItem::PartialParagraph { para_index, .. }
+                | PageItem::Table { para_index, .. } if seen.insert(*para_index) => Some(*para_index),
+                _ => None,
+            })
+            .collect::<Vec<_>>()
+    };
+    if replay_order(old) != replay_order(new) {
+        return None;
+    }
+    let start = old.pages.iter().zip(&new.pages).rposition(|(a, b)| {
+        a != b
+            || a.references_paragraph(section, paragraph)
+            || b.references_paragraph(section, paragraph)
+    }).map_or(0, |page| page + 1);
+    for (a, b) in old.pages[start..].iter_mut().zip(&mut new.pages[start..]) {
+        std::mem::swap(a, b);
+    }
+    Some(start)
 }
 
