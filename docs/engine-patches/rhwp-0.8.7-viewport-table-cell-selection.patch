+    /// Get table cell topology without rendering, or bounds for one physical page.
+    #[wasm_bindgen(js_name = getTableCellLayout)]
+    pub fn get_table_cell_layout(
+        &self,
+        section_idx: u32,
+        parent_para_idx: u32,
+        path_json: &str,
+        page: Option<u32>,
+    ) -> Result<String, JsValue> {
+        let section_idx = section_idx as usize;
+        let parent_para_idx = parent_para_idx as usize;
+        let path = DocumentCore::parse_cell_path(path_json)?;
+        let table = self.resolve_table_by_path(section_idx, parent_para_idx, &path)?;
+        if let Some(page) = page {
+            return if path.len() == 1 {
+                self.get_table_cell_bboxes_for_pages(
+                    section_idx, parent_para_idx, path[0].0, page as usize, true,
+                )
+            } else {
+                self.get_nested_table_cell_bboxes_for_pages(
+                    section_idx, parent_para_idx, &path, Some(page as usize),
+                )
+            }
+            .map_err(Into::into);
+        }
+        let cells: Vec<_> = table.cells.iter().enumerate().map(|(index, cell)| {
+            format!(
+                "{{\"cellIdx\":{},\"row\":{},\"col\":{},\"rowSpan\":{},\"colSpan\":{}}}",
+                index, cell.row, cell.col, cell.row_span, cell.col_span,
+            )
+        }).collect();
+        Ok(format!("[{}]", cells.join(",")))
     }
 
