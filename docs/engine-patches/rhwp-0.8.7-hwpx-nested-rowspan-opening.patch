+    /// Stored floating CELL tables can end their opening frame inside a row
+    /// crossed by an earlier merged cell. The row cut indexes only ordinary
+    /// cells. The merged cell keeps its existing continuation ownership.
+    fn can_restore_nested_rowspan_frame(
+        &self, table: &crate::model::table::Table, row: usize,
+    ) -> bool {
+        let profile = self.profile.get();
+        row > 0 && row < usize::from(table.row_count)
+            && profile.hwpx_stored_layout() && !profile.hwp5_origin_hwpx()
+            && !profile.session_edited()
+            && table.raw_table_record_attr & 0x08 != 0
+            && crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            && table.common.vertical_offset == 0 && table.common.flow_with_text
+            && !table.common.allow_overlap && table.caption.is_none()
+            && table.common.vert_align == VertAlign::Top
+            && table.outer_margin_top >= 0 && table.outer_margin_bottom >= 0
+            && table.page_break == TablePageBreak::RowBreak
+            && table.common.height > 0 && table.common.height <= i32::MAX as u32
+            && Self::row_has_prior_rowspan_cover(table, row)
+            && !table.cells.iter().any(|cell| {
+                usize::from(cell.row) == row && cell.row_span > 1
+            })
+    }
