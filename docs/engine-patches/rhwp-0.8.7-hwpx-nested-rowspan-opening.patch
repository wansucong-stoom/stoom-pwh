+    // A complete stored float and its blank successor close the earlier page.
+    // A following, contiguous plain-text restart reopens the enclosing margin.
+    fn saved_closed_float_plain_resume(
+        &self, table: &crate::model::table::Table, row: usize, cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> bool {
+        let profile = self.profile.get();
+        if !profile.hwpx_stored_layout() || profile.session_edited()
+            || !crate::renderer::float_placement::is_para_topbottom_float(&table.common)
+            || table.page_break != TablePageBreak::RowBreak
+            || self.render_normalization.borrow().table_text_reflowed(table)
+            || Self::row_has_prior_rowspan_cover(table, row)
+        {
+            return false;
+        }
+        let order = Self::row_cut_cell_order(table, row);
+        if order.len() != cut.len() || order.len() != usize::from(table.col_count) { return false; }
+        let mut owns_restart = false;
+        for (&index, &cursor) in order.iter().zip(cut) {
+            let cell = &table.cells[index];
+            let units = self.cell_units(cell, table, styles);
+            if cursor > units.len() { return false; }
+            if cursor == units.len() { continue; }
+            let Some(unit) = units.get(cursor) else { return false; };
+            let Some(blank_index) = unit.para_idx.checked_sub(1) else { return false; };
+            let Some(float_index) = blank_index.checked_sub(1) else { return false; };
+            let Some([owner, blank, opening, successor]) = cell.paragraphs.get(float_index..=unit.para_idx + 1)
+                else { return false; };
+            let [Control::Table(child)] = owner.controls.as_slice() else { return false; };
+            let ([first], [second]) = (opening.line_segs.as_slice(), successor.line_segs.as_slice())
+                else { return false; };
+            if cell.dirty_flag || !unit.hard_break_before || !unit.page_frame_reset_before
+                || unit.vis_start != 0 || unit.vis_end != 1
+                || !cursor.checked_sub(1).and_then(|i| units.get(i)).is_some_and(|previous|
+                    previous.para_idx == blank_index && previous.vis_end == blank.line_segs.len())
+                || !blank.text.trim().is_empty()
+                || !Self::stored_plain_cell_paragraph(opening) || !Self::stored_plain_cell_paragraph(successor)
+                || first.vertical_pos != 0 || first.line_height <= 0 || first.line_spacing < 0
+                || first.line_height.checked_add(first.line_spacing) != Some(second.vertical_pos)
+                || first.column_start != second.column_start || first.segment_width != second.segment_width
+                || ![owner, blank, opening, successor].into_iter().all(stored_float_frame_owner_is_original)
+                || stored_leading_host_float_frame(owner, Some(blank), child, true, false,
+                    self.render_normalization.borrow().table_text_reflowed(child), true).is_none()
+            {
+                return false;
+            }
+            owns_restart = true;
+        }
+        owns_restart
