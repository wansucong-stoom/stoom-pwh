+    fn saved_nested_rowspan_opening_cut(
+        &self, table: &crate::model::table::Table,
+        cells: &[&crate::model::table::Cell], units: &[std::sync::Arc<Vec<CellUnit>>],
+        prefix: f64, whole_row: f64,
+    ) -> Option<(RowCut, f64)> {
+        let band = hwpunit_to_px(table.common.height as i32, self.dpi) - prefix;
+        let epsilon = hwpunit_to_px(2, self.dpi);
+        if band <= epsilon || band + epsilon >= whole_row { return None; }
+        let mut owners = 0;
+        let mut cut = Vec::with_capacity(cells.len());
+        for (cell, units) in cells.iter().zip(units) {
+            if cell.dirty_flag || cell.text_direction != 0 || cell.paragraphs.iter().any(|p|
+                p.stored_text_partition_is_dirty() || p.cell_format_vpos_dirty
+                || p.source_frame_reflowed || !p.layout_space_metrics.is_empty()
+                || !(p.controls.is_empty() || matches!(p.controls.as_slice(), [Control::ColumnDef(columns)] if columns.column_count == 1 && columns.spacing == 0)))
+            { return None; }
+            let (cursor, opening_height) = match units.as_slice() {
+                [only] => (1, only.height),
+                [before, after] if after.hard_break_before && after.page_frame_reset_before => {
+                    let before_para = cell.paragraphs.get(before.para_idx)?;
+                    let after_para = cell.paragraphs.get(after.para_idx)?;
+                    let left = before_para.line_segs.get(before.vis_start)?;
+                    let right = after_para.line_segs.get(after.vis_start)?;
+                    if before_para.text.trim().is_empty() || after_para.text.trim().is_empty()
+                        || (left.tag | right.tag) & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+                        || left.vertical_pos != right.vertical_pos || left.vertical_pos < 0
+                        || left.column_start != right.column_start
+                        || left.segment_width <= 0 || left.segment_width != right.segment_width
+                    { return None; }
+                    owners += 1;
+                    (1, before.height)
+                }
+                _ => return None,
+            };
+            let (_, _, top, bottom) = self.resolve_cell_padding(cell, table);
+            if opening_height + top + bottom > band + epsilon { return None; }
+            cut.push(cursor);
+        }
+        (owners >= 2).then_some((cut, band))
+    }
+
+    fn saved_nested_rowspan_band_at_cut(
+        &self, table: &crate::model::table::Table, row: usize, end_cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> Option<f64> {
+        if end_cut.is_empty() || end_cut.iter().any(|&cursor| cursor != 1)
+            || !self.can_restore_nested_rowspan_frame(table, row)
+        {
+            return None;
+        }
+        let cells: Vec<_> = Self::row_cut_cell_order(table, row).into_iter()
+            .map(|index| &table.cells[index]).collect();
+        if cells.len() != end_cut.len() { return None; }
+        let previous_declared_trust = self.declared_trust_allowed.get();
+        let rows = self.resolve_row_heights(
+            table, usize::from(table.col_count), usize::from(table.row_count), None, styles, true,
+        );
+        self.declared_trust_allowed.set(previous_declared_trust);
+        let prefix = rows[..row].iter().sum::<f64>()
+            + hwpunit_to_px(table.cell_spacing as i32, self.dpi) * row as f64;
+        let units: Vec<_> = cells.iter().map(|cell| self.cell_units(cell, table, styles)).collect();
+        let (cut, band) = self.saved_nested_rowspan_opening_cut(table, &cells, &units, prefix, rows[row])?;
+        (cut == end_cut).then_some(band)
+    }
