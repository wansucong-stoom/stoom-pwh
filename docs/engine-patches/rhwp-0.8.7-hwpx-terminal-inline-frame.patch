+/// Before a saved page restart, the preceding inline line can confirm
+/// a complete table's origin instead of using a following origin.
+fn saved_terminal_inline_table_top(
+    para: &Paragraph,
+    table: &crate::model::table::Table,
+    previous: &Paragraph,
+    following: &Paragraph,
+    col_area: &LayoutRect,
+    dpi: f64,
+) -> Option<f64> {
+    use crate::model::paragraph::{ColumnBreakType, LineSeg};
+    let line = saved_inline_table_owner(para, table)?;
+    let [Control::Table(preceding)] = previous.controls.as_slice() else { return None; };
+    let before = saved_inline_table_owner(previous, preceding)?;
+    let next = following.line_segs.first()?;
+    if table.row_count < 2 || line.vertical_pos <= 0 || before.vertical_pos < 0 || before.line_spacing < 0
+        || following.column_type != ColumnBreakType::Page || next.vertical_pos != 0
+        || following.stored_text_partition_is_dirty() || following.source_frame_reflowed
+        || next.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        || before.vertical_pos.checked_add(before.line_height)?.checked_add(before.line_spacing)?
+            != line.vertical_pos
+    {
+        return None;
+    }
+    let end = hwpunit_to_px(line.vertical_pos.checked_add(line.line_height)?, dpi);
+    (end <= col_area.height).then_some(col_area.y
+        + hwpunit_to_px(line.vertical_pos + i32::from(table.outer_margin_top), dpi))
 }
 
