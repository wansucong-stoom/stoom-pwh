+
+impl StoredLeadingHostFloatFrame {
+    fn resolve(self, origin: f64, dpi: f64)
+        -> Option<crate::renderer::float_placement::ParagraphFloatPlacement>
+    {
+        use crate::renderer::float_placement::{ParagraphFloatFlow, ParagraphFloatPlacement};
+        if !origin.is_finite() || !dpi.is_finite() || dpi <= 0.0 { return None; }
+        Some(ParagraphFloatPlacement {
+            flow: ParagraphFloatFlow::Exclusion,
+            anchor_y: origin,
+            stored_host_origin: None,
+            stored_successor_line_origin: None,
+            table_left: None,
+            table_top: origin + self.table_top_hu as f64 * dpi / 7200.0,
+            occupied_bottom: origin + self.occupied_bottom_hu as f64 * dpi / 7200.0,
+        })
+    }
