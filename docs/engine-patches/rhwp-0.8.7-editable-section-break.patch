+fn section_split_offset(paragraph: &Paragraph, offset: usize, logical_end: usize) -> usize {
+    if offset == 0 {
+        return 0;
+    }
+    // Paragraph splitting also counts objects that can move with the text
+    // without occupying a body caret slot (for example a floating picture).
+    let positions = paragraph.logical_control_positions();
+    offset + paragraph.controls.iter().enumerate().filter(|(i, ctrl)| {
+        Paragraph::is_split_movable_control(ctrl)
+            && !ctrl.is_logical_inline()
+            && !matches!(ctrl, Control::CharOverlap(_))
+            && (offset == logical_end || positions.get(*i).is_some_and(|&pos| pos < offset))
+    }).count()
+}
+
+fn replace_section_opening(
+    paragraph: &mut Paragraph,
+    opening: Option<(crate::model::document::SectionDef, ColumnDef)>,
+) {
+    for i in (0..paragraph.controls.len()).rev() {
+        if matches!(paragraph.controls[i], Control::SectionDef(_) | Control::ColumnDef(_)) {
+            paragraph.remove_control(i);
+        }
+    }
+    if let Some((definition, mut column)) = opening {
+        if column.column_count == 0 {
+            column.column_count = 1;
+            column.same_width = true;
+        }
+        for (index, control) in [Control::SectionDef(Box::new(definition)), Control::ColumnDef(column)]
+            .into_iter().enumerate()
+        {
+            paragraph.shift_for_inline_control_insert(index, 0);
+            paragraph.controls.insert(index, control);
+            paragraph.ctrl_data_records.insert(index, None);
+            paragraph.char_count += EXTENDED_CTRL_UNITS as u32;
+        }
+        paragraph.control_mask |= 1 << 2;
+    } else {
+        paragraph.control_mask &= !(1 << 2);
+    }
+}
