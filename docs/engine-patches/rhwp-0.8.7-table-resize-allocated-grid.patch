+    /// A stable source revision owns resize geometry just like measured rows.
+    /// Multiple selected-cell queries share one allocation, with no page scan.
+    pub(crate) fn resize_heights(&self, table: &Table, compute: impl FnOnce() -> Vec<u32>) -> std::sync::Arc<[u32]> {
+        let owner = std::ptr::from_ref(table) as usize;
+        if let Some(heights) = self.0.lock().unwrap().resize_heights.get(&owner).cloned() { return heights; }
+        let heights: std::sync::Arc<[u32]> = compute().into();
+        let mut entries = self.0.lock().unwrap();
+        if entries.resize_heights.len() < 4096 { entries.resize_heights.insert(owner, heights.clone()); }
+        heights
