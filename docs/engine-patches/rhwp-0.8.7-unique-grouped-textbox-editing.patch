+/// A group can reuse the existing textbox address only when that address is
+/// unambiguous. Count every descendant (including ambiguous nested groups);
+/// never let traversal order select one of several text stories.
+fn grouped_textbox_count(shape: &crate::model::shape::ShapeObject, depth: usize) -> usize {
+    use crate::model::shape::ShapeObject;
+    if depth > 64 { return 2; }
+    match shape {
+        ShapeObject::Group(group) => group.children.iter()
+            .map(|child| grouped_textbox_count(child, depth + 1))
+            .fold(0usize, |count, next| (count + next).min(2)),
+        ShapeObject::Rectangle(s) => usize::from(s.drawing.text_box.is_some()),
+        ShapeObject::Ellipse(s) => usize::from(s.drawing.text_box.is_some()),
+        ShapeObject::Polygon(s) => usize::from(s.drawing.text_box.is_some()),
+        ShapeObject::Arc(s) => usize::from(s.drawing.text_box.is_some()),
+        ShapeObject::Curve(s) => usize::from(s.drawing.text_box.is_some()),
+        _ => 0,
+    }
+}
+
+fn unique_grouped_textbox_child(group: &crate::model::shape::GroupShape) -> Option<usize> {
+    let mut selected = None;
+    for (index, child) in group.children.iter().enumerate() {
+        match grouped_textbox_count(child, 1) {
+            0 => {},
+            1 if selected.is_none() => selected = Some(index),
+            _ => return None,
+        }
+    }
+    selected
+}
