{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pwh": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/launch.mjs",
        "pwh"
      ],
      "cwd": "${PLUGIN_ROOT}"
    },
    "rhwp-core": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/launch.mjs",
        "rhwp-core"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
