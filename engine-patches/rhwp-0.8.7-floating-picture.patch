+
+/// A paragraph-relative picture is anchored to the stored line containing its
+/// control, not to the beginning of a multi-line host paragraph. The saved
+/// successor independently closes the picture/caption band; retain its spacing
+/// contract instead of adding the host's text height or caption height twice.
+///
+/// This is an original-layout contract local to these paragraphs. An edit in a
+/// different paragraph does not revoke it. Callers exclude split hosts and
+/// other-page owners. Dirty/synthetic lines, a control on the
+/// first line, or an overlapping successor retain the existing flow path.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn stored_tail_topbottom_picture_placement(
+    para: &Paragraph,
+    successor: &Paragraph,
+    control_index: usize,
+    spacing_before: f64,
+    successor_spacing_before: f64,
+    frame_vpos: i32,
+    actual_host_flow_y: f64,
+    dpi: f64,
+) -> Option<ParagraphFloatPlacement> {
+    use crate::model::paragraph::{ColumnBreakType, LineSeg};
+    use crate::model::shape::CaptionDirection;
+    let [Control::Picture(picture)] = para.controls.as_slice() else {
+        return None;
+    };
+    let valid = |p: &Paragraph| {
+        !p.stored_text_partition_is_dirty()
+            && !p.cell_format_vpos_dirty
+            && !p.line_segs.is_empty()
+            && p.line_segs.iter().all(|line| {
+                line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY == 0
+                    && line.line_height > 0
+            })
+            && p.line_segs.windows(2).all(|pair| {
+                pair[1].vertical_pos >= pair[0].vertical_pos
+                    && pair[1].text_start >= pair[0].text_start
+            })
+    };
+    let common = &picture.common;
+    if control_index != 0
+        || !valid(para)
+        || !valid(successor)
+        || para.text.trim().is_empty()
+        || !successor.controls.is_empty()
+        || successor.column_type != ColumnBreakType::None
+        || common.treat_as_char
+        || !common.flow_with_text
+        || common.text_wrap != TextWrap::TopAndBottom
+        || common.vert_rel_to != VertRelTo::Para
+        || common.vert_align != VertAlign::Top
+        || !matches!(common.horz_rel_to, HorzRelTo::Column | HorzRelTo::Para)
+        || common.allow_overlap
+        || !dpi.is_finite()
+        || dpi <= 0.0
+        || !spacing_before.is_finite()
+        || spacing_before < 0.0
+        || !successor_spacing_before.is_finite()
+        || successor_spacing_before < 0.0
+        || !actual_host_flow_y.is_finite()
+    {
+        return None;
+    }
+    let owner = *stored_control_line_indices(para)?.get(control_index)?;
+    if owner == 0 || owner + 1 != para.line_segs.len() {
+        return None;
+    }
+    let first = para.line_segs.first()?;
+    let line = para.line_segs.get(owner)?;
+    let next = successor.line_segs.first()?;
+    let host_y = hwpunit_to_px(first.vertical_pos.checked_sub(frame_vpos)?, dpi);
+    let anchor_y = hwpunit_to_px(line.vertical_pos.checked_sub(frame_vpos)?, dpi);
+    let unit = dpi / 7200.0;
+    if (actual_host_flow_y + spacing_before - host_y).abs() > unit {
+        return None;
+    }
+    let offset = signed_hwpunit(common.vertical_offset);
+    let top_hu = i64::from(line.vertical_pos)
+        + i64::from(offset)
+        + i64::from(common.margin.top);
+    // The independent stored host lines must all end above the picture. This
+    // excludes text that flows around/below a float and avoids reinterpreting
+    // those paragraphs as a trailing picture band.
+    if para.line_segs.iter().any(|text_line| {
+        i64::from(text_line.vertical_pos) + i64::from(text_line.line_height) > top_hu
+    }) {
+        return None;
+    }
+    let caption_hu = match picture.caption.as_ref() {
+        None => 0,
+        Some(caption) => {
+            let [paragraph] = caption.paragraphs.as_slice() else {
+                return None;
+            };
+            if caption.direction != CaptionDirection::Bottom
+                || !valid(paragraph)
+                || !paragraph.controls.is_empty()
+            {
+                return None;
+            }
+            let cap_first = paragraph.line_segs.first()?;
+            let cap_last = paragraph.line_segs.last()?;
+            i64::from(cap_last.vertical_pos) + i64::from(cap_last.line_height)
+                - i64::from(cap_first.vertical_pos.min(0))
+                + i64::from(caption.spacing)
+        }
+    };
+    let (_, height) = picture_flow_frame_size_hu(picture);
+    let bottom_hu = top_hu + i64::from(height) + caption_hu + i64::from(common.margin.bottom);
+    let next_hu = i64::from(next.vertical_pos);
+    if height <= 0 || bottom_hu > next_hu {
+        return None;
+    }
+    let px = |value: i64| (value - i64::from(frame_vpos)) as f64 * dpi / 7200.0;
+    Some(ParagraphFloatPlacement {
+        flow: ParagraphFloatFlow::StoredPicture {
+            next_flow_y: px(next_hu) - successor_spacing_before,
+        },
+        anchor_y,
+        stored_host_origin: Some(host_y),
+        stored_successor_line_origin: Some(px(next_hu)),
+        table_left: None,
+        table_top: px(top_hu),
+        occupied_bottom: px(bottom_hu),
+    })
+}
+
+#[cfg(test)]
+mod pwh_floating_picture_tests {
+    use super::*;
+    use crate::model::paragraph::LineSeg;
+    use crate::model::shape::{Caption, CaptionDirection};
+
+    fn line(text_start: u32, vertical_pos: i32) -> LineSeg {
+        LineSeg {
+            text_start,
+            vertical_pos,
+            line_height: 600,
+            text_height: 600,
+            baseline_distance: 500,
+            segment_width: 10000,
+            ..Default::default()
+        }
+    }
+
+    fn original_frame() -> (Paragraph, Paragraph) {
+        let picture = Picture {
+            common: CommonObjAttr {
+                width: 10000,
+                height: 9000,
+                treat_as_char: false,
+                flow_with_text: true,
+                allow_overlap: false,
+                text_wrap: TextWrap::TopAndBottom,
+                vert_rel_to: VertRelTo::Para,
+                vert_align: VertAlign::Top,
+                horz_rel_to: HorzRelTo::Column,
+                vertical_offset: 1500,
+                ..Default::default()
+            },
+            caption: Some(Caption {
+                direction: CaptionDirection::Bottom,
+                spacing: 200,
+                paragraphs: vec![Paragraph {
+                    text: "Caption".into(),
+                    line_segs: vec![line(0, 0)],
+                    ..Default::default()
+                }],
+                ..Default::default()
+            }),
+            ..Default::default()
+        };
+        let host = Paragraph {
+            text: "abcdef".into(),
+            // The 8-unit picture control is immediately before the final 'f'.
+            char_offsets: vec![0, 1, 2, 3, 4, 13],
+            char_count: 15,
+            line_segs: vec![line(0, 100), line(2, 1600), line(4, 3100)],
+            controls: vec![Control::Picture(Box::new(picture))],
+            ..Default::default()
+        };
+        let next = Paragraph {
+            line_segs: vec![line(0, 14400)],
+            ..Default::default()
+        };
+        (host, next)
+    }
+
+    #[test]
+    fn pwh_floating_picture_uses_the_owning_line_including_the_first_line_inset() {
+        let (host, next) = original_frame();
+        assert_eq!(stored_control_line_indices(&host), Some(vec![2]));
+        let plan = stored_tail_topbottom_picture_placement(
+            &host, &next, 0, 100.0 / 75.0, 1.0, 0, 0.0, 96.0,
+        ).expect("the original tail picture frame is complete");
+        // The source line is 3100 HU from the column origin. Subtracting the
+        // first line's 100 HU would move the picture up by that leading inset.
+        assert!((plan.anchor_y - 3100.0 / 75.0).abs() < 1e-9);
+        let host_ink_bottom = (3100.0 + 600.0) / 75.0;
+        assert!(host_ink_bottom < plan.table_top);
+        assert!((plan.table_top - 4600.0 / 75.0).abs() < 1e-9);
+        assert!((plan.occupied_bottom - 14400.0 / 75.0).abs() < 1e-9);
+        assert!((plan.paragraph_end(1.0, 0.0) + 1.0 - 14400.0 / 75.0).abs() < 1e-9);
+        // Reading the plan never rewrites the object's relative offsets.
+        let Control::Picture(picture) = &host.controls[0] else { unreachable!() };
+        assert_eq!(picture.common.vertical_offset, 1500);
+        assert!(!picture.common.treat_as_char);
+    }
+
+    #[test]
+    fn pwh_floating_picture_rejects_stale_or_incomplete_source_frames() {
+        let (mut host, mut next) = original_frame();
+        let plan = |host: &Paragraph, next: &Paragraph| {
+            stored_tail_topbottom_picture_placement(
+                host, next, 0, 100.0 / 75.0, 1.0, 0, 0.0, 96.0,
+            )
+        };
+        host.stored_text_partition_dirty = true;
+        assert!(plan(&host, &next).is_none());
+        host.stored_text_partition_dirty = false;
+        assert!(stored_tail_topbottom_picture_placement(
+            &host, &next, 0, 100.0 / 75.0, 1.0, 0, 10.0, 96.0,
+        ).is_none(), "an upstream edit that shifted the host cannot reuse the old page origin");
+        next.line_segs[0].vertical_pos = 14399;
+        assert!(plan(&host, &next).is_none(), "a successor inside the caption is not a closed frame");
+        next.line_segs[0].vertical_pos = 14400;
+        host.line_segs[1].tag = LineSeg::TAG_IMPLEMENTATION_PROPERTY;
+        assert!(plan(&host, &next).is_none());
+    }
+
+    #[test]
+    fn pwh_floating_picture_keeps_other_anchor_and_flow_contracts() {
+        let (mut host, next) = original_frame();
+        let plan = |host: &Paragraph| {
+            stored_tail_topbottom_picture_placement(
+                host, &next, 0, 100.0 / 75.0, 1.0, 0, 0.0, 96.0,
+            )
+        };
+        if let Control::Picture(picture) = &mut host.controls[0] {
+            picture.common.vert_rel_to = VertRelTo::Paper;
+        }
+        assert!(plan(&host).is_none());
+        if let Control::Picture(picture) = &mut host.controls[0] {
+            picture.common.vert_rel_to = VertRelTo::Para;
+            picture.common.text_wrap = TextWrap::BehindText;
+        }
+        assert!(plan(&host).is_none());
+        if let Control::Picture(picture) = &mut host.controls[0] {
+            picture.common.text_wrap = TextWrap::TopAndBottom;
+            picture.common.treat_as_char = true;
+        }
+        assert!(plan(&host).is_none());
+        if let Control::Picture(picture) = &mut host.controls[0] {
+            picture.common.treat_as_char = false;
+        }
+        host.char_offsets = vec![8, 9, 10, 11, 12, 13];
+        assert!(plan(&host).is_none(), "a picture control on the first line keeps the existing path");
+    }
 }
 
